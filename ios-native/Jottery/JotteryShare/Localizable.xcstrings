    "share.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies konnte nicht in Jottery gespeichert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση στο Jottery."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This couldn't be saved to Jottery."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This couldn't be saved to Jottery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar esto en Jottery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer ceci dans Jottery."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questo contenuto in Jottery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotteryに保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery에 저장할 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kon niet in Jottery worden opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać tego w Jottery."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar isto no Jottery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить это в Jottery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içerik Jottery'ye kaydedilemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存到 Jottery。"
          }
        }
      }
    },
    "share.partlySaved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einiges konnte nicht gespeichert werden. Der Rest wird hinzugefügt, wenn Sie Jottery das nächste Mal entsperren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένα στοιχεία δεν ήταν δυνατό να αποθηκευτούν. Τα υπόλοιπα θα προστεθούν την επόμενη φορά που θα ξεκλειδώσετε το Jottery."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of this couldn't be saved. The rest will be added next time you unlock Jottery."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of this couldn't be saved. The rest will be added next time you unlock Jottery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de esto no se pudo guardar. El resto se agregará la próxima vez que desbloquee Jottery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie n'a pas pu être enregistrée. Le reste sera ajouté au prochain déverrouillage de Jottery."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare una parte di questo contenuto. Il resto verrà aggiunto al prossimo sblocco di Jottery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を保存できませんでした。残りは次にJotteryのロックを解除したときに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부를 저장할 수 없었습니다. 나머지는 다음에 Jottery를 잠금 해제할 때 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel hiervan kon niet worden opgeslagen. De rest wordt toegevoegd wanneer je Jottery de volgende keer ontgrendelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać części zawartości. Pozostała część zostanie dodana przy następnym odblokowaniu Jottery."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte disto não pôde ser salva. O resto será adicionado da próxima vez que desbloquear o Jottery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть не удалось сохранить. Остальное будет добавлено при следующей разблокировке Jottery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içeriğin bir kısmı kaydedilemedi. Geri kalanı Jottery'nin kilidini bir sonraki açışınızda eklenecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容无法保存。其余内容将在你下次解锁 Jottery 时添加。"
          }
        }
      }
    },
    "share.saved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Es bleibt auf diesem Gerät unverschlüsselt, bis Sie Jottery das nächste Mal entsperren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύτηκε. Παραμένει μη κρυπτογραφημένο σε αυτή τη συσκευή μέχρι το επόμενο ξεκλείδωμα του Jottery."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. It stays unencrypted on this device until you next unlock Jottery."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. It stays unencrypted on this device until you next unlock Jottery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Permanece sin cifrar en este dispositivo hasta que vuelva a desbloquear Jottery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Le contenu reste non chiffré sur cet appareil jusqu'au prochain déverrouillage de Jottery."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato. Rimane non crittografato su questo dispositivo fino al prossimo sblocco di Jottery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。次にJotteryのロックを解除するまで、このデバイス上では暗号化されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되었습니다. 다음에 Jottery를 잠금 해제할 때까지 이 기기에서 암호화되지 않은 상태로 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen. Het blijft onversleuteld op dit apparaat staan tot je Jottery de volgende keer ontgrendelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano. Zawartość pozostanie niezaszyfrowana na tym urządzeniu do następnego odblokowania Jottery."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo. Permanece sem encriptação neste dispositivo até desbloquear o Jottery novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. До следующей разблокировки Jottery это остаётся незашифрованным на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi. Jottery'nin kilidini bir sonraki açışınıza kadar bu cihazda şifresiz kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。在你下次解锁 Jottery 之前，它在此设备上保持未加密状态。"
          }
        }
      }
    },
