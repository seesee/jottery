    "editor.shownAsPlainText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz hat den Editor wiederholt angehalten und wird daher als Klartext angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η σημείωση σταματούσε συνεχώς τον επεξεργαστή, οπότε εμφανίζεται ως απλό κείμενο."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This note kept stopping the editor, so it's shown as plain text."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This note kept stopping the editor, so it's shown as plain text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota detenía el editor una y otra vez, así que se muestra como texto plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note bloquait sans cesse l'éditeur ; elle est donc affichée en texte brut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa nota continuava a bloccare l'editor, quindi viene mostrata come testo semplice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノートでエディターが繰り返し停止したため、プレーンテキストで表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트 때문에 편집기가 계속 멈춰서 일반 텍스트로 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie bleef de editor stoppen en wordt daarom als platte tekst getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta notatka ciągle zatrzymywała edytor, więc jest wyświetlana jako zwykły tekst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota bloqueava o editor repetidamente, por isso é mostrada como texto simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта заметка постоянно останавливала редактор, поэтому показана как обычный текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu not düzenleyiciyi sürekli durdurduğu için düz metin olarak gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔记多次导致编辑器停止运行，因此以纯文本显示。"
          }
        }
      }
