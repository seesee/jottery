    "account.sessionEnded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Sitzung ist beendet. Melden Sie sich erneut an, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία σας έληξε. Συνδεθείτε ξανά για να συνεχίσετε."
          }
        },
        "en-GB": {
          "stringUnit": {
