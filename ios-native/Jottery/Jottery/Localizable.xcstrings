{
  "sourceLanguage": "en-GB",
  "strings": {
    "#%@": {
      "comment": "A badge displaying a tag. The tag text is wrapped in `#` symbols.",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A label displaying the number of notes the user has created.",
      "isCommentAutoGenerated": true
    },
    "+%lld": {
      "comment": "A tag indicating that there are more tags visible than can be shown in the list above.",
      "isCommentAutoGenerated": true
    },
    "Deleted %@": {
      "comment": "A footer in the list item of a deleted note, showing when it was deleted.",
      "isCommentAutoGenerated": true,
