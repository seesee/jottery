    "colours.categoriesFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einer Farbe einen Namen, um sie als Kategorie zu verwenden. Suchen Sie mit category:name danach. Namen bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε όνομα σε ένα χρώμα για να το χρησιμοποιήσετε ως κατηγορία. Αναζητήστε μια κατηγορία με category:name. Τα ονόματα παραμένουν σε αυτή τη συσκευή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a colour a name to use it as a category. Search for one with category:name. Names stay on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a color a name to use it as a category. Search for one with category:name. Names stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigne un nombre a un color para usarlo como categoría. Busque una con category:name. Los nombres permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un nom à une couleur pour l'utiliser comme catégorie. Recherchez-en une avec category:name. Les noms restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome a un colore per usarlo come categoria. Cercane una con category:name. I nomi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーに名前を付けるとカテゴリとして使用できます。検索するには category:name を使用します。名前はこのデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상에 이름을 지정하면 카테고리로 사용할 수 있습니다. category:name 형식으로 검색하세요. 이름은 이 기기에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een kleur een naam om die als categorie te gebruiken. Zoek er een met category:name. Namen blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj kolorowi nazwę, aby używać go jako kategorii. Aby wyszukać kategorię, użyj category:name. Nazwy pozostają na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome a uma cor para a usar como categoria. Pesquise uma com category:name. Os nomes ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте цвету название, чтобы использовать его как категорию. Для поиска категории используйте category:name. Названия остаются на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rengi kategori olarak kullanmak için ona ad verin. category:name ile kategori arayın. Adlar bu cihazda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为颜色命名后即可将其用作类别。使用 category:name 搜索类别。名称仅保留在此设备上。"
          }
        }
      }
    },
