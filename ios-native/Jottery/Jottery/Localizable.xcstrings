    "account.tokenShownOnce": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie es jetzt. Es wird nicht erneut angezeigt und verschwindet, wenn Sie diesen Bildschirm verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράψτε το τώρα. Δεν θα εμφανιστεί ξανά και θα χαθεί όταν φύγετε από αυτή την οθόνη."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this now. It won't be shown again, and it goes when you leave this screen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this now. It won't be shown again, and it goes when you leave this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópielo ahora. No se volverá a mostrar y desaparecerá cuando salga de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez-le maintenant. Il ne sera plus affiché et disparaîtra lorsque vous quitterez cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copialo ora. Non verrà mostrato di nuovo e scomparirà quando lasci questa schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐコピーしてください。再表示されず、この画面を離れると消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 복사하세요. 다시 표시되지 않으며, 이 화면을 나가면 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer dit nu. Het wordt niet opnieuw getoond en verdwijnt wanneer je dit scherm verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj teraz. Token nie zostanie ponownie wyświetlony i zniknie, gdy opuścisz ten ekran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie-o agora. Não voltará a ser mostrado e desaparece quando sair desta tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте сейчас. Токен больше не будет показан и исчезнет, когда вы покинете этот экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu şimdi kopyalayın. Tekrar gösterilmeyecek ve bu ekrandan ayrıldığınızda kaybolacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请立即拷贝。它不会再次显示，并且会在你离开此屏幕时消失。"
          }
        }
      }
    },
