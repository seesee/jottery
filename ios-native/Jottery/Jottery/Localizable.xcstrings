            "state": "translated",
            "value": "Ontgrendel Jottery met Face ID in plaats van elke keer je wachtwoord te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuj Jottery za pomocą Face ID zamiast wpisywać hasło za każdym razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o Jottery com o Face ID em vez de digitar a senha todas as vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Jottery с помощью Face ID, не вводя пароль каждый раз."
          }
        },
        "tr": {
