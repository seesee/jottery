    "accountKey.promptMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre anderen Geräte können sich erst verbinden, wenn dieses Gerät Ihren Verschlüsselungsschlüssel hochlädt. Geben Sie Ihr Notizen-Passwort ein, um den Schlüssel zu schützen und hochzuladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άλλες συσκευές σας δεν μπορούν να συνδεθούν μέχρι αυτή η συσκευή να στείλει το κλειδί κρυπτογράφησής σας. Εισαγάγετε τον κωδικό σημειώσεων για να προστατέψετε το κλειδί και να το στείλετε."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices can't connect until this device uploads your encryption key. Enter your notes password to protect the key and upload it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices can't connect until this device uploads your encryption key. Enter your notes password to protect the key and upload it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus otros dispositivos no podrán conectarse hasta que este dispositivo suba su clave de cifrado. Ingrese su contraseña de las notas para proteger la clave y subirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos autres appareils ne pourront pas se connecter tant que cet appareil n'aura pas envoyé votre clé de chiffrement. Entrez votre mot de passe des notes pour protéger la clé et l'envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri dispositivi non possono connettersi finché questo dispositivo non carica la chiave di crittografia. Inserisci la password delle note per proteggere la chiave e caricarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが暗号化キーをアップロードするまで、他のデバイスは接続できません。ノートのパスワードを入力して、キーを保護してアップロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 암호화 키를 업로드할 때까지 다른 기기에서 연결할 수 없습니다. 노트 비밀번호를 입력하여 키를 보호하고 업로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je andere apparaten kunnen geen verbinding maken totdat dit apparaat je versleutelingssleutel heeft geüpload. Voer je notitiewachtwoord in om de sleutel te beschermen en te uploaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pozostałe urządzenia nie mogą się połączyć, dopóki to urządzenie nie prześle klucza szyfrowania. Wpisz hasło do notatek, aby zabezpieczyć klucz i go przesłać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus outros dispositivos não conseguem conectar-se até este dispositivo enviar a sua chave de encriptação. Digite a palavra-passe das notas para proteger a chave e enviá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши другие устройства не смогут подключиться, пока это устройство не загрузит ваш ключ шифрования. Введите пароль заметок, чтобы защитить ключ и загрузить его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz şifreleme anahtarınızı yükleyene kadar diğer cihazlarınız bağlanamaz. Anahtarı korumak ve yüklemek için not parolanızı girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上传加密密钥之前，你的其他设备无法连接。请输入笔记密码以保护密钥并上传。"
          }
        }
      }
    },
