    "syncServerRemoved.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server meldet, dass Notizen endgültig gelöscht wurden. Sie wurden in den Papierkorb verschoben: %lld. Falls Sie sie nicht gelöscht haben, legen Sie sie jetzt zurück. Sie bleiben 30 Tage im Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής αναφέρει ότι σημειώσεις διαγράφηκαν οριστικά και μεταφέρθηκαν στον κάδο ανακύκλωσης: %lld. Αν δεν τις διαγράψατε εσείς, επαναφέρετέ τις τώρα. Παραμένουν στον κάδο για 30 ημέρες."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says notes were permanently deleted, and they've moved to the Recycle Bin: %lld. If you didn't delete them, put them back now. They stay in the bin for 30 days."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says notes were permanently deleted, and they've moved to the Recycle Bin: %lld. If you didn't delete them, put them back now. They stay in the bin for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor indica que se eliminaron notas permanentemente y se han movido a la papelera de reciclaje: %lld. Si no las eliminó usted, devuélvalas ahora. Permanecen en la papelera 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur indique que des notes ont été supprimées définitivement ; elles ont été déplacées dans la corbeille : %lld. Si vous ne les avez pas supprimées, remettez-les en place maintenant. Elles restent 30 jours dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server indica che alcune note sono state eliminate definitivamente e sono state spostate nel cestino: %lld. Se non le hai eliminate tu, ripristinale ora. Rimarranno nel cestino per 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーによってノートが完全に削除されたため、ごみ箱に移動されました: %lld件。削除した覚えがない場合は、今すぐ元に戻してください。ごみ箱には30日間残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 노트가 영구적으로 삭제되었다고 알려 왔으며, 해당 노트는 휴지통으로 이동했습니다: %lld개. 직접 삭제한 것이 아니라면 지금 되돌려 놓으세요. 노트는 30일 동안 휴지통에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgens de server zijn notities definitief verwijderd, en ze zijn naar de prullenbak verplaatst: %lld. Als je ze niet zelf hebt verwijderd, zet ze dan nu terug. Ze blijven 30 dagen in de prullenbak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zgłasza trwałe usunięcie notatek. Zostały przeniesione do kosza: %lld. Jeśli nie zostały usunięte przez Ciebie, przywróć je teraz. Pozostaną w koszu przez 30 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor diz que notas foram excluídas permanentemente e elas foram movidas para a lixeira: %lld. Se não foi você que as excluiu, coloque-as de volta agora. Elas ficam na lixeira por 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер сообщает, что заметки были удалены навсегда, и они перемещены в корзину: %lld. Если вы их не удаляли, верните их сейчас. В корзине они хранятся 30 дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya göre notlar kalıcı olarak silindi. Geri Dönüşüm Kutusu'na taşınan not sayısı: %lld. Onları siz silmediyseniz şimdi geri koyun. Kutuda 30 gün kalırlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器表示有笔记已被永久删除，它们已被移到回收站：%lld 条。如果这不是你删除的，请现在就把它们放回去。它们会在回收站中保留 30 天。"
          }
        }
      }
    },
