          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez Jottery avec Face ID au lieu de saisir votre mot de passe à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca Jottery con Face ID invece di digitare la password ogni volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回パスワードを入力する代わりに、Face IDでJotteryのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번 비밀번호를 입력하는 대신 Face ID로 Jottery를 잠금 해제합니다."
          }
        },
        "nl": {
