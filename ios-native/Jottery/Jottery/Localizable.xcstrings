    "deleteAccount.deactivateHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto wird deaktiviert und nicht mehr synchronisiert. Für eine erneute Registrierung ist die Genehmigung eines Administrators erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας απενεργοποιείται και ο συγχρονισμός σταματά. Για νέα εγγραφή απαιτείται έγκριση από διαχειριστή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is disabled and stops syncing. Signing up again needs administrator approval."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is disabled and stops syncing. Signing up again needs administrator approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta se desactiva y deja de sincronizarse. Para volver a registrarse hace falta la aprobación de un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est désactivé et cesse de se synchroniser. Pour vous réinscrire, l'approbation d'un administrateur sera nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account viene disattivato e smette di sincronizzarsi. Per registrarti di nuovo serve l'approvazione di un amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが無効になり、同期が停止します。再度登録するには、管理者の承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 비활성화되고 동기화가 중단됩니다. 다시 가입하려면 관리자의 승인이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account wordt uitgeschakeld en stopt met synchroniseren. Om je opnieuw te registreren is goedkeuring van een beheerder nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto zostanie wyłączone i przestanie się synchronizować. Ponowna rejestracja będzie wymagać zatwierdzenia przez administratora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta é desativada e deixa de sincronizar. Para se inscrever novamente é necessária a aprovação de um administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учётная запись будет отключена и перестанет синхронизироваться. Для повторной регистрации потребуется одобрение администратора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız devre dışı bırakılır ve senkronizasyon durur. Yeniden kaydolmak için yönetici onayı gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户将被停用并停止同步。再次注册需要管理员批准。"
          }
        }
      }
    },
    "deleteAccount.deleteHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto und alles auf dem Server Gespeicherte werden dauerhaft entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας και ό,τι είναι αποθηκευμένο στον διακομιστή αφαιρούνται οριστικά. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and everything stored on the server are removed permanently. This cannot be undone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and everything stored on the server are removed permanently. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta y todo lo almacenado en el servidor se eliminan de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et tout ce qui est stocké sur le serveur sont supprimés définitivement. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account e tutto ciò che è memorizzato sul server vengono rimossi definitivamente. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとサーバーに保存されているすべてのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 서버에 저장된 모든 항목이 영구적으로 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account en alles wat op de server is opgeslagen worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto i wszystko, co jest przechowywane na serwerze, zostanie trwale usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta e tudo o que está armazenado no servidor são removidos de forma permanente. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учётная запись и всё, что хранится на сервере, будут удалены без возможности восстановления. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız ve sunucuda saklanan her şey kalıcı olarak kaldırılır. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户以及服务器上存储的所有内容将被永久移除。此操作无法撤销。"
          }
        }
      }
    },
    "deleteAccount.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies betrifft nur Ihr Konto auf dem Synchronisationsserver. Notizen, die sich bereits auf diesem Gerät befinden, bleiben erhalten – verwenden Sie Einstellungen → Zurücksetzen, um sie zu entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό επηρεάζει μόνο τον λογαριασμό σας στον διακομιστή συγχρονισμού. Οι σημειώσεις που υπάρχουν ήδη σε αυτή τη συσκευή διατηρούνται — χρησιμοποιήστε τις Ρυθμίσεις → Επαναφορά για να τις αφαιρέσετε."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This affects only your account on the sync server. Notes already on this device are kept — use Settings → Reset to remove those."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This affects only your account on the sync server. Notes already on this device are kept — use Settings → Reset to remove those."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo afecta a su cuenta en el servidor de sincronización. Las notas que ya están en este dispositivo se conservan; use Configuración → Restablecer para eliminarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n'affecte que votre compte sur le serveur de synchronisation. Les notes déjà présentes sur cet appareil sont conservées ; utilisez Paramètres → Réinitialiser pour les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione riguarda solo il tuo account sul server di sincronizzazione. Le note già presenti su questo dispositivo vengono conservate: per rimuoverle, usa Impostazioni → Ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期サーバー上のアカウントにのみ影響します。このデバイスにすでにあるノートは残ります。削除するには、設定の「リセット」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 서버의 계정에만 영향을 줍니다. 이미 이 기기에 있는 노트는 유지됩니다. 삭제하려면 설정 → 재설정을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit heeft alleen invloed op je account op de synchronisatieserver. Notities die al op dit apparaat staan, blijven bewaard. Gebruik Instellingen → Resetten om die te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy to tylko Twojego konta na serwerze synchronizacji. Notatki znajdujące się już na tym urządzeniu zostaną zachowane — aby je usunąć, użyj Ustawienia → Resetuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto afeta apenas a sua conta no servidor de sincronização. As notas que já estão neste dispositivo são mantidas — use Configurações → Redefinir para removê-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это затрагивает только вашу учётную запись на сервере синхронизации. Заметки, которые уже есть на этом устройстве, сохраняются — чтобы удалить их, используйте Настройки → Сбросить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem yalnızca senkronizasyon sunucusundaki hesabınızı etkiler. Bu cihazdaki notlar korunur — onları kaldırmak için Ayarlar → Sıfırla'yı kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会影响你在同步服务器上的账户。此设备上已有的笔记会保留；如需移除，请使用“设置”→“重置”。"
          }
        }
      }
    },
