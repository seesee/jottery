    "backup.reminderBlocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Jottery deaktiviert, daher können keine Erinnerungen erscheinen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γνωστοποιήσεις είναι απενεργοποιημένες για το Jottery, οπότε οι υπενθυμίσεις δεν μπορούν να εμφανιστούν."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Jottery, so reminders can't appear."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Jottery, so reminders can't appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Jottery, así que los recordatorios no pueden aparecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Jottery ; les rappels ne peuvent donc pas s'afficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Jottery, quindi i promemoria non possono apparire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotteryの通知がオフになっているため、リマインダーを表示できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery 알림이 꺼져 있어 백업 알림을 표시할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit voor Jottery, dus herinneringen kunnen niet verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia dla Jottery są wyłączone, więc przypomnienia nie mogą się pojawiać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Jottery, por isso os lembretes não podem aparecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для Jottery выключены, поэтому напоминания не могут появляться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery için bildirimler kapalı, bu yüzden hatırlatıcılar görünemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery 的通知已关闭，因此无法显示提醒。"
          }
        }
      }
    },
    "backup.reminderBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Jottery, um ein Backup Ihrer Notizen zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Jottery για να δημιουργήσετε αντίγραφο ασφαλείας των σημειώσεών σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Jottery to make a backup of your notes."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Jottery to make a backup of your notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Jottery para crear una copia de seguridad de sus notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Jottery pour créer une sauvegarde de vos notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Jottery per fare un backup delle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotteryを開いてノートをバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery를 열어 노트를 백업하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Jottery om een back-up van je notities te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Jottery, aby utworzyć kopię zapasową notatek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Jottery para fazer um backup das suas notas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Jottery, чтобы создать резервную копию заметок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınızı yedeklemek için Jottery'yi açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Jottery 以备份你的笔记。"
          }
        }
      }
    },
