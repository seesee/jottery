    "error.combineAttachmentNotOnDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notizen konnten nicht zusammengeführt werden: Ein Anhang ist noch nicht auf diesem Gerät angekommen. Synchronisieren Sie und versuchen Sie es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο συνδυασμός των σημειώσεων: ένα συνημμένο δεν έχει φτάσει ακόμα σε αυτή τη συσκευή. Συγχρονίστε και δοκιμάστε ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't combine the notes: an attachment hasn't reached this device yet. Sync, then try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't combine the notes: an attachment hasn't reached this device yet. Sync, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron combinar las notas: un archivo adjunto aún no ha llegado a este dispositivo. Sincronice y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de combiner les notes : une pièce jointe n'est pas encore arrivée sur cet appareil. Synchronisez, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile combinare le note: un allegato non è ancora arrivato su questo dispositivo. Sincronizza, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを結合できませんでした。添付ファイルがまだこのデバイスに届いていません。同期してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 병합할 수 없습니다. 첨부파일이 아직 이 기기에 도착하지 않았습니다. 동기화한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notities konden niet worden samengevoegd: een bijlage is nog niet op dit apparaat aangekomen. Synchroniseer en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć notatek: załącznik nie dotarł jeszcze na to urządzenie. Zsynchronizuj notatki, a następnie spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível combinar as notas: um anexo ainda não chegou a este dispositivo. Sincronize e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось объединить заметки: одно из вложений ещё не попало на это устройство. Выполните синхронизацию, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar birleştirilemedi: Bir ek henüz bu cihaza ulaşmadı. Senkronize edin, ardından yeniden deneyin."
          }
        },
        "zh-Hans": {
