    "syncSetup.notesPasswordHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort, mit dem Sie Ihre Notizen entsperren; es schützt Ihren Verschlüsselungsschlüssel auf dem Server. Es muss sich von Ihrem Server-Passwort unterscheiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός με τον οποίο ξεκλειδώνετε τις σημειώσεις σας, που προστατεύει το κλειδί κρυπτογράφησης στον διακομιστή. Πρέπει να διαφέρει από τον κωδικό διακομιστή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The password that unlocks your notes, used to protect your encryption key on the server. It must be different from your server password."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The password that unlocks your notes, used to protect your encryption key on the server. It must be different from your server password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña que desbloquea sus notas, usada para proteger su clave de cifrado en el servidor. Debe ser distinta de su contraseña del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe qui déverrouille vos notes, utilisé pour protéger votre clé de chiffrement sur le serveur. Il doit être différent de votre mot de passe du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password che sblocca le tue note, usata per proteggere la chiave di crittografia sul server. Deve essere diversa dalla password del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートのロック解除に使うパスワードで、サーバー上の暗号化キーを保護するために使用します。サーバーパスワードとは異なるものにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 잠금 해제하는 비밀번호이며, 서버에서 암호화 키를 보호하는 데 사용됩니다. 서버 비밀번호와 달라야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord waarmee je je notities ontgrendelt, gebruikt om je versleutelingssleutel op de server te beschermen. Het moet verschillen van je serverwachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło, które odblokowuje Twoje notatki; służy do ochrony klucza szyfrowania na serwerze. Musi się różnić od hasła serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe que desbloqueia as suas notas, usada para proteger a chave de encriptação no servidor. Tem de ser diferente da palavra-passe do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль, который разблокирует ваши заметки и защищает ваш ключ шифрования на сервере. Он должен отличаться от пароля сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınızın kilidini açan parola; sunucudaki şifreleme anahtarınızı korumak için kullanılır. Sunucu şifrenizden farklı olmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于解锁笔记的密码，也用于在服务器上保护你的加密密钥。它必须与你的服务器密码不同。"
          }
        }
      }
    },
    "syncSetup.passwordsMatchWarning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Notizen-Passwort stimmt mit Ihrem Server-Passwort überein. Der Server erhält Ihr Server-Passwort und könnte damit Ihre Notizen öffnen. Sie können sich trotzdem verbinden, ändern Sie Ihr Notizen-Passwort danach aber in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σημειώσεων είναι ίδιος με τον κωδικό διακομιστή. Ο διακομιστής λαμβάνει τον κωδικό διακομιστή, οπότε θα μπορούσε να τον χρησιμοποιήσει για να ανοίξει τις σημειώσεις σας. Μπορείτε να συνδεθείτε, αλλά αλλάξτε στη συνέχεια τον κωδικό σημειώσεων στις Ρυθμίσεις."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes password matches your server password. The server receives your server password, so it could use it to open your notes. You can still connect, but change your notes password in Settings afterwards."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes password matches your server password. The server receives your server password, so it could use it to open your notes. You can still connect, but change your notes password in Settings afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña de las notas coincide con su contraseña del servidor. El servidor recibe su contraseña del servidor, por lo que podría usarla para abrir sus notas. Aun así puede conectarse, pero cambie después su contraseña de las notas en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe des notes est identique à votre mot de passe du serveur. Le serveur reçoit votre mot de passe du serveur et pourrait donc l'utiliser pour ouvrir vos notes. Vous pouvez quand même vous connecter, mais modifiez ensuite votre mot de passe des notes dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password delle note è uguale alla password del server. Il server riceve la password del server, quindi potrebbe usarla per aprire le note. Puoi comunque connetterti, ma in seguito cambia la password delle note nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートのパスワードがサーバーパスワードと同じです。サーバーはサーバーパスワードを受け取るため、それを使ってノートを開けてしまう可能性があります。このまま接続することもできますが、その後で設定からノートのパスワードを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 비밀번호가 서버 비밀번호와 같습니다. 서버는 서버 비밀번호를 받으므로, 이를 이용해 노트를 열 수 있습니다. 계속 연결할 수는 있지만, 이후에 설정에서 노트 비밀번호를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitiewachtwoord is gelijk aan je serverwachtwoord. De server ontvangt je serverwachtwoord en zou het dus kunnen gebruiken om je notities te openen. Je kunt nog steeds verbinding maken, maar wijzig daarna je notitiewachtwoord in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło do notatek jest takie samo jak hasło serwera. Serwer otrzymuje hasło serwera, więc mógłby nim otworzyć Twoje notatki. Nadal możesz się połączyć, ale potem zmień hasło do notatek w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe das notas é igual à palavra-passe do servidor. O servidor recebe a palavra-passe do servidor, por isso poderia usá-la para abrir as suas notas. Ainda pode conectar, mas altere depois a palavra-passe das notas nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль заметок совпадает с паролем сервера. Сервер получает пароль сервера, поэтому мог бы использовать его для открытия ваших заметок. Вы всё равно можете подключиться, но затем измените пароль заметок в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not parolanız sunucu şifrenizle aynı. Sunucu şifreniz sunucuya gönderilir, bu yüzden sunucu bu şifreyle notlarınızı açabilir. Yine de bağlanabilirsiniz, ancak sonrasında Ayarlar'dan not parolanızı değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记密码与服务器密码相同。服务器会收到你的服务器密码，因此可能用它打开你的笔记。你仍可继续连接，但之后请在“设置”中更改笔记密码。"
          }
        }
      }
    },
