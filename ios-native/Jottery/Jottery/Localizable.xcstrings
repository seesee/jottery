    "accountKey.passwordMatchesAccountMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Notizen-Passwort stimmt mit Ihrem Server-Passwort überein. Der Server erhält Ihr Server-Passwort und könnte damit Ihre Notizen öffnen. Ändern Sie Ihr Notizen-Passwort in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σημειώσεων είναι ίδιος με τον κωδικό διακομιστή. Ο διακομιστής λαμβάνει τον κωδικό διακομιστή, οπότε θα μπορούσε να τον χρησιμοποιήσει για να ανοίξει τις σημειώσεις σας. Αλλάξτε τον κωδικό σημειώσεων στις Ρυθμίσεις."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes password matches your server password. The server receives your server password, so it could use it to open your notes. Change your notes password in Settings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes password matches your server password. The server receives your server password, so it could use it to open your notes. Change your notes password in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña de las notas coincide con su contraseña del servidor. El servidor recibe su contraseña del servidor, por lo que podría usarla para abrir sus notas. Cambie su contraseña de las notas en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe des notes est identique à votre mot de passe du serveur. Le serveur reçoit votre mot de passe du serveur et pourrait donc l'utiliser pour ouvrir vos notes. Modifiez votre mot de passe des notes dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password delle note è uguale alla password del server. Il server riceve la password del server, quindi potrebbe usarla per aprire le note. Cambia la password delle note nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートのパスワードがサーバーパスワードと同じです。サーバーはサーバーパスワードを受け取るため、それを使ってノートを開けてしまう可能性があります。設定でノートのパスワードを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 비밀번호가 서버 비밀번호와 같습니다. 서버는 서버 비밀번호를 받으므로, 이를 이용해 노트를 열 수 있습니다. 설정에서 노트 비밀번호를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitiewachtwoord is gelijk aan je serverwachtwoord. De server ontvangt je serverwachtwoord en zou het dus kunnen gebruiken om je notities te openen. Wijzig je notitiewachtwoord in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło do notatek jest takie samo jak hasło serwera. Serwer otrzymuje hasło serwera, więc mógłby nim otworzyć Twoje notatki. Zmień hasło do notatek w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe das notas é igual à palavra-passe do servidor. O servidor recebe a palavra-passe do servidor, por isso poderia usá-la para abrir as suas notas. Altere a palavra-passe das notas nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль заметок совпадает с паролем сервера. Сервер получает пароль сервера, поэтому мог бы использовать его для открытия ваших заметок. Измените пароль заметок в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not parolanız sunucu şifrenizle aynı. Sunucu şifreniz sunucuya gönderilir, bu yüzden sunucu bu şifreyle notlarınızı açabilir. Ayarlar'dan not parolanızı değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记密码与服务器密码相同。服务器会收到你的服务器密码，因此可能用它打开你的笔记。请在“设置”中更改笔记密码。"
          }
        }
      }
    },
