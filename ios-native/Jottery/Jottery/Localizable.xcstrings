      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort verschlüsselt Ihre Notizen und muss mindestens 8 Zeichen lang sein. Bei Verlust können die Daten nicht wiederhergestellt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κωδικός κρυπτογραφεί τις σημειώσεις σας και πρέπει να έχει τουλάχιστον 8 χαρακτήρες. Αν χαθεί, τα δεδομένα δεν μπορούν να ανακτηθούν."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This password encrypts your notes, and must be at least 8 characters. If lost, data cannot be recovered."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This password encrypts your notes, and must be at least 8 characters. If lost, data cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta contraseña cifra sus notas y debe tener al menos 8 caracteres. Si la pierde, los datos no se podrán recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe chiffre vos notes et doit comporter au moins 8 caractères. En cas de perte, les données ne pourront pas être récupérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa password crittografa le tue note e deve contenere almeno 8 caratteri. Se viene persa, i dati non possono essere recuperati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスワードでノートが暗号化されます。8文字以上にしてください。紛失するとデータを復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비밀번호로 노트를 암호화하며, 8자 이상이어야 합니다. 분실하면 데이터를 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wachtwoord versleutelt je notities en moet minstens 8 tekens bevatten. Bij verlies kunnen je gegevens niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To hasło szyfruje Twoje notatki i musi mieć co najmniej 8 znaków. Jeśli je zgubisz, nie będzie można odzyskać danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta palavra-passe encripta as suas notas e tem de ter pelo menos 8 caracteres. Se for perdida, os dados não podem ser recuperados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль шифрует ваши заметки и должен содержать не менее 8 символов. В случае утраты данные невозможно восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola notlarınızı şifreler ve en az 8 karakter olmalıdır. Kaybolursa veriler kurtarılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码用于加密你的笔记，且至少需要 8 个字符。如果丢失，数据将无法恢复。"
          }
        }
      }
    },
