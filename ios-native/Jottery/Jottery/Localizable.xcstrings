        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile risolvere questo conflitto. Non è cambiato nulla, quindi puoi riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この競合を解決できませんでした。何も変更されていないため、もう一度お試しいただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 충돌을 해결할 수 없습니다. 아무것도 변경되지 않았으므로 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit conflict kon niet worden opgelost. Er is niets gewijzigd, dus je kunt het opnieuw proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozwiązać tego konfliktu. Nic się nie zmieniło, więc możesz spróbować ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível resolver este conflito. Nada foi alterado, por isso pode tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разрешить этот конфликт. Ничего не изменилось, поэтому можно повторить попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
