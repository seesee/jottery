    "unlock.enableFaceIdMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie Jottery mit Face ID, anstatt jedes Mal Ihr Passwort einzugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε το Jottery με Face ID αντί να πληκτρολογείτε τον κωδικό σας κάθε φορά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Jottery with Face ID instead of typing your password each time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Jottery with Face ID instead of typing your password each time."
          }
        },
        "es": {
