    "bulk.combineExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus ihrem Text und Kopien ihrer Anhänge wird eine neue Notiz erstellt. Die Originale werden in den Papierkorb verschoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργείται μια νέα σημείωση με το κείμενό τους και αντίγραφα των συνημμένων τους. Οι αρχικές σημειώσεις μετακινούνται στον κάδο ανακύκλωσης."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A new note is made with their text and copies of their attachments. The originals move to the Recycle Bin."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A new note is made with their text and copies of their attachments. The originals move to the Recycle Bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea una nota nueva con su texto y copias de sus archivos adjuntos. Las originales se mueven a la papelera de reciclaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle note est créée avec leur texte et des copies de leurs pièces jointes. Les notes originales sont déplacées dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene creata una nuova nota con il loro testo e le copie dei loro allegati. Le note originali vengono spostate nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらのテキストと添付ファイルのコピーを含む新しいノートが作成されます。元のノートはごみ箱に移動されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 노트의 텍스트와 첨부파일 사본으로 새 노트가 만들어집니다. 원본은 휴지통으로 이동됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een nieuwe notitie gemaakt met hun tekst en kopieën van hun bijlagen. De originelen worden naar de prullenbak verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powstanie nowa notatka z ich tekstem i kopiami załączników. Oryginały zostaną przeniesione do kosza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É criada uma nova nota com o texto delas e cópias dos anexos. As originais são movidas para a lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет создана новая заметка с их текстом и копиями вложений. Исходные заметки будут перемещены в корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notların metni ve eklerinin kopyalarıyla yeni bir not oluşturulur. Orijinal notlar Geri Dönüşüm Kutusu'na taşınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将用这些笔记的文本和附件副本创建一条新笔记。原笔记会移到回收站。"
          }
        }
      }
