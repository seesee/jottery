    "changePassword.oldBackups": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits erstellte Backups lassen sich weiterhin mit Ihrem alten Passwort öffnen. Falls es offengelegt wurde, löschen Sie diese Backups."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αντίγραφα ασφαλείας που έχετε ήδη δημιουργήσει ανοίγουν ακόμη με τον παλιό κωδικό σας. Αν ενδέχεται να έχει διαρρεύσει, διαγράψτε τα."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups you've already made still open with your old password. If it may have been exposed, delete them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups you've already made still open with your old password. If it may have been exposed, delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad que ya ha creado se siguen abriendo con su contraseña anterior. Si esta ha podido quedar expuesta, elimínelas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes déjà créées s’ouvrent toujours avec votre ancien mot de passe. S’il a pu être divulgué, supprimez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup già creati si aprono ancora con la vecchia password. Se potrebbe essere stata esposta, eliminali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成済みのバックアップは、以前のパスワードで引き続き開けます。パスワードが漏えいした可能性がある場合は、それらを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 만든 백업은 이전 비밀번호로 계속 열 수 있습니다. 비밀번호가 노출되었을 수 있다면 해당 백업을 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Back-ups die je al hebt gemaakt, openen nog steeds met je oude wachtwoord. Als dat mogelijk is uitgelekt, verwijder ze dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzone już kopie zapasowe nadal otwierają się starym hasłem. Jeśli mogło ono wyciec, usuń te kopie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups que já criou continuam a abrir com a sua palavra-passe antiga. Se esta pode ter sido exposta, elimine-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже созданные резервные копии по-прежнему открываются старым паролем. Если он мог быть раскрыт, удалите их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce oluşturduğunuz yedekler eski şifrenizle açılmaya devam eder. Şifreniz açığa çıkmış olabilirse bu yedekleri silin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建的备份仍可用旧密码打开。如果旧密码可能已泄露，请删除这些备份。"
          }
        }
      }
    },
    "changePassword.serverKeyPending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Passwort wurde auf diesem Gerät geändert, aber der Server konnte nicht aktualisiert werden. Jottery versucht es weiter. Bis dahin benötigt ein neues Gerät Ihr altes Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σας άλλαξε σε αυτή τη συσκευή, αλλά ο διακομιστής δεν ενημερώθηκε. Το Jottery θα συνεχίσει να προσπαθεί. Μέχρι τότε, μια νέα συσκευή θα χρειάζεται τον παλιό σας κωδικό."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has changed on this device, but the server couldn't be updated. Jottery will keep trying. Until then, a new device needs your old password."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has changed on this device, but the server couldn't be updated. Jottery will keep trying. Until then, a new device needs your old password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña ha cambiado en este dispositivo, pero no se pudo actualizar el servidor. Jottery seguirá intentándolo. Hasta entonces, un dispositivo nuevo necesitará su contraseña anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a été modifié sur cet appareil, mais le serveur n'a pas pu être mis à jour. Jottery continuera d'essayer. En attendant, un nouvel appareil aura besoin de votre ancien mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password è stata cambiata su questo dispositivo, ma non è stato possibile aggiornare il server. Jottery continuerà a riprovare. Fino ad allora, un nuovo dispositivo avrà bisogno della vecchia password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではパスワードが変更されましたが、サーバーを更新できませんでした。Jotteryは再試行を続けます。それまでは、新しいデバイスには以前のパスワードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 비밀번호가 변경되었지만 서버를 업데이트할 수 없었습니다. Jottery가 계속 시도합니다. 그때까지 새 기기에는 이전 비밀번호가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord is op dit apparaat gewijzigd, maar de server kon niet worden bijgewerkt. Jottery blijft het proberen. Tot die tijd heeft een nieuw apparaat je oude wachtwoord nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło zostało zmienione na tym urządzeniu, ale nie udało się zaktualizować serwera. Jottery będzie ponawiać próby. Do tego czasu nowe urządzenie będzie wymagać Twojego starego hasła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua palavra-passe foi alterada neste dispositivo, mas não foi possível atualizar o servidor. O Jottery continuará a tentar. Até lá, um novo dispositivo precisa da sua palavra-passe antiga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль изменён на этом устройстве, но сервер обновить не удалось. Jottery будет продолжать попытки. До тех пор новому устройству потребуется ваш старый пароль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz bu cihazda değiştirildi ancak sunucu güncellenemedi. Jottery denemeye devam edecek. O zamana kadar yeni bir cihaz eski şifrenize ihtiyaç duyar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密码已在此设备上更改，但无法更新服务器。Jottery 会继续尝试。在此之前，新设备需要使用你的旧密码。"
          }
        }
      }
    },
    "changePassword.successMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Passwort wurde geändert. Alle Daten wurden neu verschlüsselt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός πρόσβασής σας άλλαξε. Όλα τα δεδομένα κρυπτογραφήθηκαν εκ νέου."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has been changed. All data has been re-encrypted."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has been changed. All data has been re-encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña se ha cambiado. Todos los datos se han vuelto a cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a été modifié. Toutes les données ont été rechiffrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password è stata cambiata. Tutti i dati sono stati crittografati di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更しました。すべてのデータが再暗号化されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 변경되었습니다. 모든 데이터가 다시 암호화되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord is gewijzigd. Alle gegevens zijn opnieuw versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło zostało zmienione. Wszystkie dane zostały ponownie zaszyfrowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua palavra-passe foi alterada. Todos os dados foram encriptados novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль изменён. Все данные зашифрованы заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz değiştirildi. Tüm veriler yeniden şifrelendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密码已更改。所有数据已重新加密。"
          }
        }
      }
    },
