    "account.signInHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit Ihrem Synchronisationskonto an, um Ihre Nutzung zu sehen und das Konto zu verwalten. Sie bleiben angemeldet, bis Sie diesen Bildschirm verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε με τον λογαριασμό συγχρονισμού σας για να δείτε τη χρήση σας και να διαχειριστείτε τον λογαριασμό. Η σύνδεση θα παραμείνει ενεργή μέχρι να φύγετε από αυτή την οθόνη."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your sync account to see your usage and manage the account. You'll stay signed in until you leave this screen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your sync account to see your usage and manage the account. You'll stay signed in until you leave this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión con su cuenta de sincronización para ver su uso y administrar la cuenta. Seguirá con la sesión iniciada hasta que salga de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte de synchronisation pour voir votre utilisation et gérer le compte. Vous restez connecté jusqu'à ce que vous quittiez cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account di sincronizzazione per vedere l'utilizzo e gestire l'account. L'accesso resterà attivo finché non lasci questa schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期アカウントでサインインすると、使用状況の確認とアカウントの管理ができます。この画面を離れるまでサインインしたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 계정으로 로그인하면 사용량을 확인하고 계정을 관리할 수 있습니다. 이 화면을 나갈 때까지 로그인 상태가 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met je synchronisatieaccount om je gebruik te bekijken en het account te beheren. Je blijft ingelogd tot je dit scherm verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na konto synchronizacji, aby zobaczyć wykorzystanie i zarządzać kontem. Logowanie będzie aktywne, dopóki nie opuścisz tego ekranu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com a sua conta de sincronização para ver o uso e gerenciar a conta. Permanecerá com a sessão iniciada até sair desta tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в учётную запись синхронизации, чтобы видеть использование и управлять ею. Вход сохранится, пока вы не покинете этот экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımınızı görmek ve hesabı yönetmek için senkronizasyon hesabınızla giriş yapın. Bu ekrandan ayrılana kadar oturumunuz açık kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的同步账户登录，以查看使用情况并管理账户。在离开此屏幕之前，你将保持登录状态。"
          }
        }
      }
    },
