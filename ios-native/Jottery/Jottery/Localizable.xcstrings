    "syncSetup.awaitingApproval": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto wartet auf die Genehmigung durch einen Administrator. Jottery verbindet dieses Gerät, sobald es genehmigt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας αναμένει έγκριση από διαχειριστή. Το Jottery θα συνδέσει αυτή τη συσκευή μόλις εγκριθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is waiting for an administrator to approve it. Jottery will connect this device once it's approved."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is waiting for an administrator to approve it. Jottery will connect this device once it's approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta está esperando la aprobación de un administrador. Jottery conectará este dispositivo en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte attend l'approbation d'un administrateur. Jottery connectera cet appareil dès qu'il sera approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è in attesa dell'approvazione di un amministratore. Jottery collegherà questo dispositivo una volta approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは管理者の承認待ちです。承認されると、Jotteryがこのデバイスを接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 관리자의 승인을 기다리고 있습니다. 승인되면 Jottery가 이 기기를 연결합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account wacht op goedkeuring van een beheerder. Jottery verbindt dit apparaat zodra het is goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto czeka na zatwierdzenie przez administratora. Jottery połączy to urządzenie po zatwierdzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta está à espera de aprovação por um administrador. O Jottery conectará este dispositivo assim que ela for aprovada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учётная запись ожидает одобрения администратора. Jottery подключит это устройство после одобрения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız bir yöneticinin onayını bekliyor. Onaylandığında Jottery bu cihazı bağlayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户正在等待管理员批准。批准后，Jottery 会连接此设备。"
