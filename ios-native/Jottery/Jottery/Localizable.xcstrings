    "unlock.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle lokalen Daten gelöscht, einschließlich Notizen, Einstellungen und Verschlüsselungsschlüssel. Wenn Ihre Notizen mit einem Server synchronisiert sind, können Sie sie durch erneutes Verbinden wiederherstellen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφούν όλα τα τοπικά δεδομένα, συμπεριλαμβανομένων των σημειώσεων, των ρυθμίσεων και των κλειδιών κρυπτογράφησης. Αν οι σημειώσεις σας είναι συγχρονισμένες με διακομιστή, μπορείτε να τις ανακτήσετε συνδεόμενοι ξανά. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local data including notes, settings, and encryption keys. If your notes are synced to a server, you can recover them by connecting again. This action cannot be undone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local data including notes, settings, and encryption keys. If your notes are synced to a server, you can recover them by connecting again. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todos los datos locales, incluidas las notas, los ajustes y las claves de cifrado. Si sus notas están sincronizadas con un servidor, puede recuperarlas volviendo a conectarse. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera toutes les données locales, y compris les notes, les réglages et les clés de chiffrement. Si vos notes sont synchronisées avec un serveur, vous pouvez les récupérer en vous reconnectant. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti i dati locali, incluse note, impostazioni e chiavi di crittografia. Se le note sono sincronizzate su un server, puoi recuperarle connettendoti di nuovo. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、設定、暗号化キーを含むすべてのローカルデータが削除されます。ノートがサーバーに同期されている場合は、再接続して復元できます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트, 설정, 암호화 키를 포함한 모든 로컬 데이터가 삭제됩니다. 노트가 서버에 동기화되어 있다면 다시 연결하여 복구할 수 있습니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert alle lokale gegevens, waaronder notities, instellingen en versleutelingssleutels. Als je notities met een server zijn gesynchroniseerd, kun je ze terughalen door opnieuw verbinding te maken. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich danych lokalnych, w tym notatek, ustawień i kluczy szyfrowania. Jeśli Twoje notatki są zsynchronizowane z serwerem, możesz je odzyskać, łącząc się ponownie. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai excluir todos os dados locais, incluindo notas, configurações e chaves de encriptação. Se as suas notas estiverem sincronizadas com um servidor, você poderá recuperá-las ao conectar novamente. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены все локальные данные, включая заметки, настройки и ключи шифрования. Если ваши заметки синхронизированы с сервером, вы сможете восстановить их, подключившись снова. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem notlar, ayarlar ve şifreleme anahtarları dahil tüm yerel verileri siler. Notlarınız bir sunucuya senkronize edildiyse yeniden bağlanarak kurtarabilirsiniz. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有本地数据，包括笔记、设置和加密密钥。如果你的笔记已同步到服务器，可以重新连接来恢复。此操作无法撤销。"
          }
        }
      }
    },
