    "conflict.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version konnte nicht entschlüsselt werden und kann daher weder angezeigt noch behalten werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποκρυπτογράφηση αυτής της έκδοσης, οπότε δεν μπορεί να εμφανιστεί ή να διατηρηθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This version couldn't be decrypted, so it can't be shown or kept."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This version couldn't be decrypted, so it can't be shown or kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no se pudo descifrar, así que no se puede mostrar ni conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n'a pas pu être déchiffrée ; elle ne peut donc être ni affichée ni conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decrittografare questa versione, quindi non può essere mostrata né conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンは復号できなかったため、表示も保持もできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전은 복호화할 수 없어 표시하거나 유지할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie kon niet worden ontsleuteld en kan dus niet worden getoond of bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odszyfrować tej wersji, więc nie można jej wyświetlić ani zachować."
          }
