    "health.serverFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob der Server noch jeden Anhang hat, der auf diesem Gerät vorhanden ist, ohne sie herunterzuladen. Alles, was er verloren hat, kann von hier aus erneut gesendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχει ότι ο διακομιστής έχει ακόμα κάθε συνημμένο που υπάρχει σε αυτή τη συσκευή, χωρίς να τα κατεβάζει. Ό,τι έχει χάσει μπορεί να σταλεί ξανά από εδώ."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the server still has each attachment this device holds, without downloading them. Anything it has lost can be sent back from here."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the server still has each attachment this device holds, without downloading them. Anything it has lost can be sent back from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el servidor aún tiene cada archivo adjunto de este dispositivo, sin descargarlos. Lo que haya perdido se puede volver a enviar desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que le serveur possède toujours chaque pièce jointe de cet appareil, sans les télécharger. Tout ce qu'il a perdu peut être renvoyé à partir d'ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla che il server abbia ancora ogni allegato presente su questo dispositivo, senza scaricarli. Tutto ciò che ha perso può essere reinviato da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにある添付ファイルがサーバーにも残っているかを、ダウンロードせずに確認します。サーバーから失われたものは、ここから再送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있는 각 첨부파일이 서버에도 남아 있는지 다운로드하지 않고 확인합니다. 서버에서 사라진 항목은 여기에서 다시 보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert of de server nog elke bijlage heeft die op dit apparaat staat, zonder ze te downloaden. Wat de server kwijt is, kan hiervandaan worden teruggestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdza, czy serwer nadal ma każdy załącznik z tego urządzenia, bez ich pobierania. Wszystko, co utracił, można stąd wysłać ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se o servidor ainda tem cada anexo deste dispositivo, sem os baixar. O que ele tiver perdido pode ser enviado novamente a partir daqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, есть ли на сервере все вложения с этого устройства, не скачивая их. Всё, что сервер потерял, можно отправить обратно отсюда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki her ekin sunucuda hâlâ bulunup bulunmadığını, ekleri indirmeden kontrol eder. Sunucunun kaybettiği her şey buradan geri gönderilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查服务器是否仍保留此设备上的每个附件，无需下载。服务器丢失的内容可从此处重新发送。"
          }
        }
      }
    },
