    "syncDisconnect.serverTooOld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist zu alt, um Geräte über die App zu trennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο διακομιστής είναι πολύ παλιός για την αποσύνδεση συσκευών από την εφαρμογή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is too old to unlink devices from the app."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is too old to unlink devices from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor es demasiado antiguo para desvincular dispositivos desde la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est trop ancien pour dissocier des appareils depuis l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server è troppo vecchio per scollegare i dispositivi dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは古いため、アプリからデバイスのリンクを解除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 너무 오래되어 앱에서 기기 연결을 해제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server is te oud om apparaten vanuit de app los te koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer jest zbyt stary, aby można było odłączać urządzenia z poziomu aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor é antigo demais para desvincular dispositivos a partir do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер слишком старый, чтобы отключать устройства из приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu çok eski olduğu için cihazların bağlantısı uygulamadan kesilemiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器版本过旧，无法在 App 中取消设备关联。"
          }
        }
      }
    },
    "syncDisconnect.stillRegistered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät getrennt, aber es ist weiterhin auf Ihrem Server registriert. Entfernen Sie es aus der Geräteliste Ihres Servers. (%@)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποσύνδεση έγινε σε αυτή τη συσκευή, αλλά η συσκευή εξακολουθεί να είναι εγγεγραμμένη στον διακομιστή σας. Αφαιρέστε την από τη λίστα συσκευών του διακομιστή σας. (%@)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected on this device, but it is still registered on your server. Remove it from your server's device list. (%@)"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected on this device, but it is still registered on your server. Remove it from your server's device list. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado en este dispositivo, pero sigue registrado en su servidor. Elimínelo de la lista de dispositivos de su servidor. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté sur cet appareil, mais toujours enregistré sur votre serveur. Retirez-le de la liste des appareils de votre serveur. (%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnesso su questo dispositivo, ma è ancora registrato sul server. Rimuovilo dall'elenco dei dispositivi del server. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは切断しましたが、サーバーにはまだ登録されています。サーバーのデバイス一覧から削除してください。(%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 연결이 해제되었지만 서버에는 여전히 등록되어 있습니다. 서버의 기기 목록에서 제거하세요. (%@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat is de verbinding verbroken, maar het staat nog geregistreerd op je server. Verwijder het uit de apparatenlijst van je server. (%@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączono na tym urządzeniu, ale jest ono nadal zarejestrowane na Twoim serwerze. Usuń je z listy urządzeń na serwerze. (%@)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado neste dispositivo, mas ele ainda está registrado no seu servidor. Remova-o da lista de dispositivos do servidor. (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено на этом устройстве, но оно всё ещё зарегистрировано на вашем сервере. Удалите его из списка устройств вашего сервера. (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda bağlantı kesildi, ancak cihaz sunucunuzda hâlâ kayıtlı. Sunucunuzun cihaz listesinden kaldırın. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在此设备上断开连接，但它仍在你的服务器上注册。请从服务器的设备列表中将其移除。(%@)"
          }
        }
      }
    },
