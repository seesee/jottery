            "state": "translated",
            "value": "Dieser Anhang kann hier nicht entschlüsselt werden und wurde daher nicht gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το συνημμένο δεν μπορεί να αποκρυπτογραφηθεί εδώ, οπότε δεν στάλθηκε."
          }
        },
        "en-GB": {
          "stringUnit": {
