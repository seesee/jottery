    "account.deleteNotesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen auf diesem Gerät werden nicht gelöscht, ebenso wenig Kopien auf Ihren anderen Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σε αυτή τη συσκευή δεν διαγράφονται, ούτε τα αντίγραφα στις άλλες συσκευές σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes on this device aren't deleted, and neither are copies on your other devices."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes on this device aren't deleted, and neither are copies on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de este dispositivo no se eliminan, ni tampoco las copias de sus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sur cet appareil ne sont pas supprimées, pas plus que les copies sur vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note su questo dispositivo non vengono eliminate, né le copie sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のノートは削除されません。他のデバイス上のコピーも削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 노트는 삭제되지 않으며, 다른 기기의 사본도 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities op dit apparaat worden niet verwijderd, en kopieën op je andere apparaten ook niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki na tym urządzeniu nie zostaną usunięte, podobnie jak ich kopie na pozostałych urządzeniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas neste dispositivo não são excluídas, nem as cópias nos seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки на этом устройстве не удаляются, как и их копии на других ваших устройствах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki notlar ve diğer cihazlarınızdaki kopyalar silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的笔记不会被删除，你其他设备上的副本也不会被删除。"
          }
        }
      }
    },
    "account.deleteNotesMessage %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dadurch werden %lld Notiz und ihre Anhänge endgültig vom Server gelöscht. Dies kann nicht rückgängig gemacht werden. Notizen auf diesem Gerät bleiben hier, gelangen aber erst wieder auf den Server, wenn Sie sie ändern. Geben Sie zur Bestätigung Ihr Kontopasswort ein."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dadurch werden alle %lld Notizen und ihre Anhänge endgültig vom Server gelöscht. Dies kann nicht rückgängig gemacht werden. Notizen auf diesem Gerät bleiben hier, gelangen aber erst wieder auf den Server, wenn Sie sie ändern. Geben Sie zur Bestätigung Ihr Kontopasswort ein."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Θα διαγραφεί οριστικά από τον διακομιστή %lld σημείωση μαζί με τα συνημμένα της και αυτή η ενέργεια δεν μπορεί να αναιρεθεί. Οι σημειώσεις σε αυτή τη συσκευή παραμένουν εδώ, αλλά δεν θα επιστρέψουν στον διακομιστή μέχρι να τις αλλάξετε. Εισαγάγετε τον κωδικό λογαριασμού για επιβεβαίωση."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Θα διαγραφούν οριστικά από τον διακομιστή και οι %lld σημειώσεις μαζί με τα συνημμένα τους και αυτή η ενέργεια δεν μπορεί να αναιρεθεί. Οι σημειώσεις σε αυτή τη συσκευή παραμένουν εδώ, αλλά δεν θα επιστρέψουν στον διακομιστή μέχρι να τις αλλάξετε. Εισαγάγετε τον κωδικό λογαριασμού για επιβεβαίωση."
                }
              }
            }
          }
        },
        "en-GB": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This permanently deletes %lld note and its attachments from the server, and it can't be undone. Notes on this device stay here, but they won't go back to the server until you change them. Enter your account password to confirm."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This permanently deletes all %lld notes and their attachments from the server, and it can't be undone. Notes on this device stay here, but they won't go back to the server until you change them. Enter your account password to confirm."
                }
              }
            }
          }
        },
        "en-US": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This permanently deletes %lld note and its attachments from the server, and it can't be undone. Notes on this device stay here, but they won't go back to the server until you change them. Enter your account password to confirm."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This permanently deletes all %lld notes and their attachments from the server, and it can't be undone. Notes on this device stay here, but they won't go back to the server until you change them. Enter your account password to confirm."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esto elimina permanentemente %lld nota y sus archivos adjuntos del servidor. Esta acción no se puede deshacer. Las notas de este dispositivo se quedan aquí, pero no volverán al servidor hasta que las modifique. Ingrese la contraseña de su cuenta para confirmar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esto elimina permanentemente todas las %lld notas y sus archivos adjuntos del servidor. Esta acción no se puede deshacer. Las notas de este dispositivo se quedan aquí, pero no volverán al servidor hasta que las modifique. Ingrese la contraseña de su cuenta para confirmar."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cela supprime définitivement %lld note et ses pièces jointes du serveur. Cette action est irréversible. Les notes sur cet appareil y restent, mais ne retourneront sur le serveur que lorsque vous les modifierez. Entrez le mot de passe de votre compte pour confirmer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cela supprime définitivement toutes les %lld notes et leurs pièces jointes du serveur. Cette action est irréversible. Les notes sur cet appareil y restent, mais ne retourneront sur le serveur que lorsque vous les modifierez. Entrez le mot de passe de votre compte pour confirmer."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nota e i suoi allegati verranno eliminati definitivamente dal server e l'operazione non può essere annullata. Le note su questo dispositivo rimangono qui, ma non torneranno sul server finché non le modifichi. Inserisci la password dell'account per confermare."
                }
              },
