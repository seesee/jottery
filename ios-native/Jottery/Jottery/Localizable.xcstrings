          }
        }
      }
    },
    "health.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kann auf diesem Gerät nicht gelesen werden, ist aber auf einem anderen möglicherweise lesbar. Beim Löschen wird sie von allen Geräten entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορεί να διαβαστεί σε αυτή τη συσκευή, αλλά ίσως διαβάζεται σε άλλη. Η διαγραφή την αφαιρεί από όλες τις συσκευές και δεν μπορεί να αναιρεθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't be read on this device, but it may be readable on another. Deleting it removes it from every device, and that can't be undone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't be read on this device, but it may be readable on another. Deleting it removes it from every device, and that can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer en este dispositivo, pero quizá se pueda leer en otro. Al eliminarla se quita de todos los dispositivos. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est illisible sur cet appareil, mais peut être lisible sur un autre. La supprimer la retire de tous les appareils. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può essere letta su questo dispositivo, ma potrebbe esserlo su un altro. L'eliminazione la rimuove da tutti i dispositivi e non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは読み取れませんが、別のデバイスでは読み取れる可能性があります。削除するとすべてのデバイスから削除され、この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 읽을 수 없지만 다른 기기에서는 읽을 수도 있습니다. 삭제하면 모든 기기에서 제거되며, 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie kan op dit apparaat niet worden gelezen, maar op een ander apparaat misschien wel. Verwijderen haalt de notitie van alle apparaten en dat kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej notatki nie można odczytać na tym urządzeniu, ale może być czytelna na innym. Usunięcie usuwa ją ze wszystkich urządzeń. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser lida neste dispositivo, mas pode ser legível em outro. Excluí-la remove-a de todos os dispositivos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту заметку нельзя прочитать на этом устройстве, но, возможно, удастся на другом. Удаление уберёт её со всех устройств. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda okunamıyor, ancak başka bir cihazda okunabilir. Silmek, notu tüm cihazlardan kaldırır ve bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上无法读取它，但其他设备上可能可以读取。删除后它将从所有设备中移除，且此操作无法撤销。"
          }
        }
      }
    },
