    "changePassword.warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Ihre Daten neu verschlüsselt. Merken Sie sich Ihr neues Passwort gut – es gibt keine Möglichkeit zur Wiederherstellung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα δεδομένα σας θα κρυπτογραφηθούν εκ νέου. Βεβαιωθείτε ότι θυμάστε τον νέο κωδικό πρόσβασης — δεν υπάρχει δυνατότητα ανάκτησης."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will re-encrypt all your data. Make sure you remember your new password — there is no recovery option."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This will re-encrypt all your data. Make sure you remember your new password — there is no recovery option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto volverá a cifrar todos sus datos. Asegúrese de recordar su nueva contraseña: no hay opción de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela rechiffrera toutes vos données. Assurez-vous de retenir votre nouveau mot de passe : il n'existe aucune option de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi dati verranno crittografati di nuovo. Assicurati di ricordare la nuova password: non esiste alcuna opzione di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータが再暗号化されます。復旧手段はないため、新しいパスワードを必ず覚えておいてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터가 다시 암호화됩니다. 복구 방법이 없으므로 새 비밀번호를 꼭 기억해 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden al je gegevens opnieuw versleuteld. Zorg dat je je nieuwe wachtwoord onthoudt: het kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie Twoje dane zostaną ponownie zaszyfrowane. Upewnij się, że pamiętasz nowe hasło — nie ma opcji odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai encriptar novamente todos os seus dados. Certifique-se de que se lembra da nova palavra-passe — não há opção de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши данные будут зашифрованы заново. Убедитесь, что помните новый пароль — возможности восстановления нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tüm verilerinizi yeniden şifreler. Yeni şifrenizi hatırladığınızdan emin olun — kurtarma seçeneği yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将重新加密你的所有数据。请务必记住新密码，因为无法恢复。"
          }
        }
      }
    },
