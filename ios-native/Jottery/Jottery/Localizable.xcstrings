          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "An inbox token lets scripts and other tools send notes to your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un token de bandeja de entrada permite que scripts y otras herramientas envíen notas a su bandeja de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un token de boîte de réception permet aux scripts et à d'autres outils d'envoyer des notes dans votre boîte de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un token della posta in arrivo consente a script e altri strumenti di inviare note alla tua posta in arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイトークンを使うと、スクリプトなどのツールから受信トレイにノートを送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 편지함 토큰을 사용하면 스크립트와 기타 도구에서 받은 편지함으로 노트를 보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een inbox-token kunnen scripts en andere tools notities naar je Postvak IN sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token skrzynki odbiorczej pozwala skryptom i innym narzędziom wysyłać notatki do Twojej skrzynki odbiorczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
