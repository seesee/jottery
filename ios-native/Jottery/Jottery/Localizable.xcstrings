    "syncError.storageFull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto hat den gesamten Speicherplatz belegt, daher erreichen Änderungen den Server nicht. Sie sind auf diesem Gerät sicher. Löschen Sie nicht benötigte Notizen oder Anhänge und leeren Sie den Papierkorb, um Platz zu schaffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας εξάντλησε τον αποθηκευτικό του χώρο, οπότε οι αλλαγές δεν φτάνουν στον διακομιστή. Είναι ασφαλείς σε αυτή τη συσκευή. Για να ελευθερώσετε χώρο, διαγράψτε σημειώσεις ή συνημμένα που δεν χρειάζεστε και αδειάστε τον κάδο ανακύκλωσης."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has used all its storage, so changes aren't reaching the server. They're safe on this device. To make room, delete notes or attachments you don't need, and empty the Recycle Bin."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has used all its storage, so changes aren't reaching the server. They're safe on this device. To make room, delete notes or attachments you don't need, and empty the Recycle Bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta ha usado todo su almacenamiento, así que los cambios no llegan al servidor. Están a salvo en este dispositivo. Para liberar espacio, elimine las notas o los archivos adjuntos que no necesite y vacíe la papelera de reciclaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte a utilisé tout son espace de stockage ; les modifications n'atteignent donc pas le serveur. Elles sont en sécurité sur cet appareil. Pour libérer de l'espace, supprimez les notes ou pièces jointes dont vous n'avez pas besoin et videz la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account ha esaurito lo spazio di archiviazione, quindi le modifiche non raggiungono il server. Sono al sicuro su questo dispositivo. Per fare spazio, elimina le note o gli allegati che non ti servono e svuota il cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのストレージを使い切ったため、変更がサーバーに届いていません。変更はこのデバイスに安全に保存されています。空き容量を確保するには、不要なノートや添付ファイルを削除し、ごみ箱を空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 저장 공간을 모두 사용하여 변경 사항이 서버에 전달되지 않고 있습니다. 변경 사항은 이 기기에 안전하게 있습니다. 공간을 확보하려면 필요 없는 노트나 첨부파일을 삭제하고 휴지통을 비우세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account heeft al zijn opslagruimte gebruikt, dus wijzigingen bereiken de server niet. Ze staan veilig op dit apparaat. Verwijder notities of bijlagen die je niet nodig hebt en leeg de prullenbak om ruimte te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto wykorzystało całą dostępną pamięć, więc zmiany nie docierają na serwer. Są bezpieczne na tym urządzeniu. Aby zwolnić miejsce, usuń niepotrzebne notatki lub załączniki i opróżnij kosz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta usou todo o armazenamento, por isso as alterações não estão chegando ao servidor. Elas estão seguras neste dispositivo. Para liberar espaço, exclua notas ou anexos de que não precisa e esvazie a lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашей учётной записи закончилось место, поэтому изменения не попадают на сервер. Они в безопасности на этом устройстве. Чтобы освободить место, удалите ненужные заметки или вложения и очистите корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız tüm depolama alanını kullandı, bu yüzden değişiklikler sunucuya ulaşmıyor. Bu cihazda güvendeler. Yer açmak için ihtiyacınız olmayan notları veya ekleri silin ve Geri Dönüşüm Kutusu'nu boşaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户已用完所有存储空间，因此更改无法到达服务器。它们在此设备上是安全的。若要腾出空间，请删除不需要的笔记或附件，并清空回收站。"
          }
        }
      }
    },
    "syncError.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat zu lange für die Antwort gebraucht. Jottery versucht es in Kürze erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής άργησε πολύ να απαντήσει. Το Jottery θα δοκιμάσει ξανά σύντομα."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to answer. Jottery will try again shortly."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to answer. Jottery will try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tardó demasiado en responder. Jottery lo volverá a intentar en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a mis trop de temps à répondre. Jottery réessaiera sous peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha impiegato troppo tempo a rispondere. Jottery riproverà a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答に時間がかかりすぎました。Jotteryはまもなく再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답이 너무 오래 걸렸습니다. Jottery가 곧 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server deed er te lang over om te antwoorden. Jottery probeert het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zbyt długo nie odpowiadał. Jottery wkrótce spróbuje ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor demorou demais para responder. O Jottery tentará novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер слишком долго не отвечал. Jottery скоро повторит попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun yanıt vermesi çok uzun sürdü. Jottery kısa süre içinde yeniden deneyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应时间过长。Jottery 稍后会重试。"
          }
        }
      }
    },
    "syncError.unauthorised": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
