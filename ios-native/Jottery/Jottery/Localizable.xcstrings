    "backup.reminderHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery kann Sie erinnern, wenn ein Backup fällig ist. Es erstellt jedoch keines für Sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Jottery μπορεί να σας υπενθυμίζει πότε πρέπει να δημιουργήσετε αντίγραφο ασφαλείας. Δεν θα το δημιουργήσει για εσάς."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery can remind you when a backup is due. It won't make one for you."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery can remind you when a backup is due. It won't make one for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery puede recordarle cuándo toca hacer una copia de seguridad. No la hará por usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery peut vous rappeler quand une sauvegarde est à faire. Il ne la fera pas à votre place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery può ricordarti quando è ora di fare un backup. Non lo farà al posto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの時期になるとJotteryが通知します。バックアップは自動では作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery가 백업할 때가 되면 알려 줍니다. 백업을 대신 만들지는 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery kan je eraan herinneren wanneer er een back-up nodig is. Jottery maakt de back-up niet voor je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery może przypominać o terminie kopii zapasowej, ale nie utworzy jej za Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Jottery pode lembrar quando for hora de fazer um backup. Ele não faz o backup por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery может напоминать, когда пора создать резервную копию, но не создаст её за вас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery, yedekleme zamanı geldiğinde size hatırlatabilir. Yedeklemeyi sizin yerinize yapmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jottery 可以在需要备份时提醒你，但不会替你创建备份。"
          }
        }
      }
    },
