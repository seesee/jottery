        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに保持されませんでした。ノートを編集すると解決する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 유지되지 않았습니다. 노트를 편집하면 해결될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft dit niet bewaard. De notitie bewerken kan helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tego nie zachował. Edycja notatki może pomóc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não o manteve. Editar a nota pode ajudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер это не сохранил. Может помочь изменение заметки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bunu korumadı. Notu düzenlemek işe yarayabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未保留此内容。编辑笔记可能会有帮助。"
