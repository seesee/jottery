    "conflict.couldntResolve": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Konflikt konnte nicht gelöst werden. Es wurde nichts geändert, Sie können es also erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επίλυση αυτής της σύγκρουσης. Δεν άλλαξε τίποτα, οπότε μπορείτε να δοκιμάσετε ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't resolve this conflict. Nothing has changed, so you can try again."
          }
        },
