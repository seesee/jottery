    "account.revokeTokenMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was es verwendet, kann dann keine Notizen mehr an Ihren Posteingang senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι το χρησιμοποιεί δεν θα μπορεί πλέον να στέλνει σημειώσεις στα εισερχόμενά σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything that uses it will no longer be able to send notes to your inbox."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything that uses it will no longer be able to send notes to your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que lo use dejará de poder enviar notas a su bandeja de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui l'utilise ne pourra plus envoyer de notes dans votre boîte de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che lo usa non potrà più inviare note alla tua posta in arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトークンを使用しているものは、受信トレイにノートを送信できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 토큰을 사용하는 모든 항목에서 더 이상 받은 편지함으로 노트를 보낼 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat het gebruikt, kan dan geen notities meer naar je Postvak IN sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co z niego korzysta, nie będzie już mogło wysyłać notatek do Twojej skrzynki odbiorczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que o usa deixará de poder enviar notas para a sua caixa de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что его использует, больше не сможет отправлять заметки во входящие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu kullanan hiçbir şey artık gelen kutunuza not gönderemeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有使用它的工具将无法再向你的收件箱发送笔记。"
          }
        }
      }
    },
