    "setup.restoreHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie das Passwort ein, mit dem das Backup erstellt wurde. Es wird auch Ihr Passwort auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον κωδικό με τον οποίο δημιουργήθηκε το αντίγραφο ασφαλείας. Θα είναι επίσης ο κωδικός σας σε αυτή τη συσκευή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the password the backup was made with. It will also be your password on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the password the backup was made with. It will also be your password on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese la contraseña con la que se creó la copia de seguridad. También será su contraseña en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le mot de passe utilisé pour créer la sauvegarde. Il deviendra aussi votre mot de passe sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password con cui è stato creato il backup. Sarà anche la tua password su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの作成時に使用したパスワードを入力してください。このパスワードは、このデバイスのパスワードにもなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 만들 때 사용한 비밀번호를 입력하세요. 이 비밀번호가 이 기기의 비밀번호로도 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het wachtwoord in waarmee de back-up is gemaakt. Dit wordt ook je wachtwoord op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło użyte podczas tworzenia kopii zapasowej. Będzie to również Twoje hasło na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a palavra-passe com que o backup foi criado. Será também a sua palavra-passe neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, использованный при создании резервной копии. Он также станет вашим паролем на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme oluşturulurken kullanılan şifreyi girin. Bu, aynı zamanda bu cihazdaki şifreniz olacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
