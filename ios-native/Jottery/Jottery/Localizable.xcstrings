    "forceSync.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Notizen erneut vom Server geladen. Bei großen Bibliotheken kann das eine Weile dauern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι σημειώσεις θα ληφθούν ξανά από τον διακομιστή. Αυτό μπορεί να διαρκέσει αρκετά σε μεγάλες βιβλιοθήκες."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will re-download all notes from the server. This may take a while for large libraries."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This will re-download all notes from the server. This may take a while for large libraries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverán a descargar todas las notas del servidor. Esto puede tardar un poco en bibliotecas grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retéléchargera toutes les notes depuis le serveur. Cela peut prendre un certain temps pour les grandes bibliothèques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le note verranno scaricate di nuovo dal server. Con librerie di grandi dimensioni potrebbe volerci un po' di tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーからすべてのノートを再ダウンロードします。ノートが多い場合は時間がかかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 모든 노트를 다시 다운로드합니다. 노트가 많으면 시간이 걸릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle notities opnieuw van de server gedownload. Bij grote bibliotheken kan dit even duren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie notatki zostaną ponownie pobrane z serwera. W przypadku dużych bibliotek może to chwilę potrwać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai baixar novamente todas as notas do servidor. Pode demorar um pouco em bibliotecas grandes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все заметки будут заново загружены с сервера. Для больших коллекций это может занять некоторое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tüm notları sunucudan yeniden indirir. Büyük kitaplıklarda bu biraz zaman alabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从服务器重新下载所有笔记。如果笔记很多，可能需要一些时间。"
          }
        }
      }
    },
