    "restore.vaultExists": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat bereits einen Tresor. Um darin wiederherzustellen, gehen Sie in den Einstellungen zu „Backup und Wiederherstellung“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συσκευή έχει ήδη θησαυροφυλάκιο. Για να κάνετε αποκατάσταση σε αυτό, μεταβείτε στο Αντίγραφο ασφαλείας & αποκατάσταση στις Ρυθμίσεις."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This device already has a vault. To restore into it, go to Backup & Restore in Settings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This device already has a vault. To restore into it, go to Backup & Restore in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya tiene una bóveda. Para restaurar en ella, vaya a Copia de seguridad y restauración en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil possède déjà un coffre. Pour y restaurer une sauvegarde, accédez à Sauvegarde et restauration dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo ha già una cassaforte. Per ripristinare al suo interno, vai a Backup e ripristino nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはすでに保管庫があります。そこに復元するには、設定の「バックアップと復元」に移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 이미 금고가 있습니다. 여기로 복원하려면 설정 → 백업 및 복원으로 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft al een kluis. Ga naar Back-up en herstel in Instellingen om daarin te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie ma już sejf. Aby przywrócić do niego dane, przejdź do sekcji Kopia zapasowa i przywracanie w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo já tem um cofre. Para restaurar nele, vá a Backup e restauração nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве уже есть хранилище. Чтобы восстановить данные в него, откройте раздел «Резервное копирование и восстановление» в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda zaten bir kasa var. Bu kasaya geri yüklemek için Ayarlar'da Yedekleme ve Geri Yükleme'ye gidin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
