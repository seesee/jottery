    "colours.tagsFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie mit color:name jede Notiz mit einem farbigen Schlagwort. Schlagwortfarben bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε όλες τις σημειώσεις με χρωματιστή ετικέτα χρησιμοποιώντας color:name. Τα χρώματα ετικετών παραμένουν σε αυτή τη συσκευή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Find every note with a coloured tag using color:name. Tag colours stay on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Find every note with a colored tag using color:name. Tag colors stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre todas las notas con una etiqueta de color usando color:name. Los colores de las etiquetas permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez toutes les notes ayant une étiquette colorée avec color:name. Les couleurs des étiquettes restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova tutte le note con un tag colorato usando color:name. I colori dei tag restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "color:name を使用すると、カラー付きのタグが付いたノートをすべて検索できます。タグのカラーはこのデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "color:name 형식으로 색상 태그가 있는 모든 노트를 찾을 수 있습니다. 태그 색상은 이 기기에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind alle notities met een gekleurde tag met color:name. Tagkleuren blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby znaleźć wszystkie notatki z kolorowym tagiem, użyj color:name. Kolory tagów pozostają na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre todas as notas com uma etiqueta colorida usando color:name. As cores das etiquetas ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы найти все заметки с цветным тегом, используйте color:name. Цвета тегов остаются на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "color:name kullanarak renkli etiketi olan tüm notları bulun. Etiket renkleri bu cihazda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 color:name 查找所有带彩色标签的笔记。标签颜色仅保留在此设备上。"
          }
        }
      }
    },
