    "account.inboxHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Posteingang-Token können Skripte und andere Tools Notizen an Ihren Posteingang senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα token εισερχομένων επιτρέπει σε σενάρια και άλλα εργαλεία να στέλνουν σημειώσεις στα εισερχόμενά σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
