    "account.replaceTokenMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Token funktioniert dann nicht mehr, und alles, was es verwendet, benötigt das neue."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τρέχον token θα σταματήσει να λειτουργεί και ό,τι το χρησιμοποιεί θα χρειαστεί το νέο."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The current token will stop working, and anything that uses it will need the new one."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The current token will stop working, and anything that uses it will need the new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token actual dejará de funcionar, y todo lo que lo use necesitará el nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le token actuel cessera de fonctionner, et tout ce qui l'utilise aura besoin du nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il token attuale smetterà di funzionare e tutto ciò che lo usa avrà bisogno di quello nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のトークンは使用できなくなります。このトークンを使用しているものには新しいトークンが必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 토큰은 더 이상 작동하지 않으며, 이 토큰을 사용하는 모든 항목에 새 토큰이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het huidige token werkt dan niet meer, en alles wat het gebruikt heeft het nieuwe nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecny token przestanie działać, a wszystko, co z niego korzysta, będzie potrzebować nowego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O token atual deixará de funcionar, e tudo o que o usa precisará do novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий токен перестанет работать, и всему, что его использует, понадобится новый."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli token çalışmayı durduracak ve onu kullanan her şey yenisine ihtiyaç duyacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前令牌将失效，所有使用它的工具都需要新令牌。"
          }
        }
      }
    },
