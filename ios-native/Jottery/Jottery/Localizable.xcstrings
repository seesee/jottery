    "backup.createDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie ein verschlüsseltes Backup aller Ihrer Notizen und Anhänge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα κρυπτογραφημένο αντίγραφο ασφαλείας όλων των σημειώσεων και των συνημμένων σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an encrypted backup of all your notes and attachments."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an encrypted backup of all your notes and attachments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree una copia de seguridad cifrada de todas sus notas y archivos adjuntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une sauvegarde chiffrée de toutes vos notes et pièces jointes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un backup crittografato di tutte le note e degli allegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのノートと添付ファイルの暗号化バックアップを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 노트와 첨부파일의 암호화된 백업을 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een versleutelde back-up van al je notities en bijlagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz zaszyfrowaną kopię zapasową wszystkich notatek i załączników."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um backup encriptado de todas as suas notas e anexos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте зашифрованную резервную копию всех ваших заметок и вложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm notlarınızın ve eklerinizin şifreli bir yedeğini oluşturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有笔记和附件创建加密备份。"
          }
        }
      }
    },
