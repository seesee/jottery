    "syncError.notesTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, die der Server wegen ihrer Größe nicht akzeptiert: %lld. Sie sind auf diesem Gerät sicher, und alles andere wurde synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώσεις που ο διακομιστής δεν δέχεται επειδή είναι πολύ μεγάλες: %lld. Είναι ασφαλείς σε αυτή τη συσκευή και όλα τα υπόλοιπα έχουν συγχρονιστεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes the server won't accept because they're too large: %lld. They're safe on this device, and everything else has synced."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes the server won't accept because they're too large: %lld. They're safe on this device, and everything else has synced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que el servidor no acepta por ser demasiado grandes: %lld. Están a salvo en este dispositivo y todo lo demás se ha sincronizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes que le serveur refuse car elles sont trop volumineuses : %lld. Elles sont en sécurité sur cet appareil et tout le reste a été synchronisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note che il server non accetta perché troppo grandi: %lld. Sono al sicuro su questo dispositivo e tutto il resto è stato sincronizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが大きすぎてサーバーが受け付けないノート: %lld件。これらはこのデバイスに安全に保存されており、それ以外はすべて同期済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 커서 서버가 받지 않는 노트: %lld개. 이 노트는 이 기기에 안전하게 있으며, 나머지는 모두 동기화되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities die de server niet accepteert omdat ze te groot zijn: %lld. Ze staan veilig op dit apparaat en al het andere is gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki, których serwer nie przyjmie, bo są zbyt duże: %lld. Są bezpieczne na tym urządzeniu, a wszystko inne zostało zsynchronizowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que o servidor não aceita por serem grandes demais: %lld. Estão seguras neste dispositivo e tudo o resto foi sincronizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки, которые сервер не принимает из-за большого размера: %lld. Они в безопасности на этом устройстве, всё остальное синхронизировано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok büyük olduğu için sunucunun kabul etmediği not sayısı: %lld. Bu notlar bu cihazda güvende ve geri kalan her şey senkronize edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因过大而被服务器拒收的笔记：%lld 条。它们在此设备上是安全的，其他内容均已同步。"
          }
        }
      }
    },
    "syncError.passwordChangeRequired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto muss sein Passwort ändern, bevor ein neues Gerät verbunden werden kann. Melden Sie sich in einem Browser bei Ihrem Server an, um es zu ändern, und versuchen Sie es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός πρέπει να αλλάξει τον κωδικό του πριν συνδεθεί νέα συσκευή. Συνδεθείτε στον διακομιστή σας από ένα πρόγραμμα περιήγησης για να τον αλλάξετε και δοκιμάστε ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has to change its password before a new device can connect. Sign in to your server in a browser to change it, then try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has to change its password before a new device can connect. Sign in to your server in a browser to change it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta debe cambiar su contraseña antes de que pueda conectarse un dispositivo nuevo. Inicie sesión en su servidor desde un navegador para cambiarla y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte doit changer son mot de passe avant qu'un nouvel appareil puisse se connecter. Connectez-vous à votre serveur dans un navigateur pour le modifier, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account deve cambiare la password prima che un nuovo dispositivo possa connettersi. Accedi al server da un browser per cambiarla, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイスを接続するには、このアカウントのパスワードを変更する必要があります。ブラウザでサーバーにサインインして変更してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기를 연결하려면 이 계정의 비밀번호를 변경해야 합니다. 브라우저에서 서버에 로그인하여 변경한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit account moet het wachtwoord worden gewijzigd voordat een nieuw apparaat verbinding kan maken. Log in een browser in op je server om het te wijzigen en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto musi zmienić hasło, zanim będzie można połączyć nowe urządzenie. Zaloguj się na serwerze w przeglądarce, aby je zmienić, a następnie spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem de alterar a palavra-passe antes de um novo dispositivo poder conectar-se. Entre no seu servidor em um navegador para a alterar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой учётной записи нужно сменить пароль, прежде чем можно будет подключить новое устройство. Войдите на свой сервер в браузере, чтобы сменить его, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir cihazın bağlanabilmesi için önce bu hesabın şifresini değiştirmesi gerekiyor. Değiştirmek için bir tarayıcıda sunucunuza giriş yapın, ardından yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户必须先更改密码，新设备才能连接。请在浏览器中登录你的服务器进行更改，然后重试。"
          }
        }
      }
    },
