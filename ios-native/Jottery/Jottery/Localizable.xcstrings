    "accountKey.promptWrongPassword": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsches Notizen-Passwort. Geben Sie das Passwort ein, mit dem Sie Ihre Notizen entsperren, damit sich Ihre anderen Geräte verbinden können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λανθασμένος κωδικός σημειώσεων. Εισαγάγετε τον κωδικό με τον οποίο ξεκλειδώνετε τις σημειώσεις σας, ώστε να μπορούν να συνδεθούν οι άλλες συσκευές σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect notes password. Enter the password you use to unlock your notes, so your other devices can connect."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect notes password. Enter the password you use to unlock your notes, so your other devices can connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña de las notas incorrecta. Ingrese la contraseña que usa para desbloquear sus notas, para que sus otros dispositivos puedan conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe des notes incorrect. Entrez le mot de passe que vous utilisez pour déverrouiller vos notes, afin que vos autres appareils puissent se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Password delle note errata. Inserisci la password che usi per sbloccare le note, così gli altri dispositivi potranno connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートのパスワードが正しくありません。他のデバイスが接続できるよう、ノートのロック解除に使用しているパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 비밀번호가 올바르지 않습니다. 다른 기기에서 연결할 수 있도록, 노트를 잠금 해제할 때 사용하는 비밀번호를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onjuist notitiewachtwoord. Voer het wachtwoord in waarmee je je notities ontgrendelt, zodat je andere apparaten verbinding kunnen maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowe hasło do notatek. Wpisz hasło, którego używasz do odblokowywania notatek, aby pozostałe urządzenia mogły się połączyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavra-passe das notas incorreta. Digite a palavra-passe que usa para desbloquear as suas notas, para que os outros dispositivos possam conectar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль заметок. Введите пароль, которым вы разблокируете свои заметки, чтобы ваши другие устройства могли подключиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not parolası yanlış. Diğer cihazlarınızın bağlanabilmesi için notlarınızın kilidini açtığınız parolayı girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记密码错误。请输入你用于解锁笔记的密码，以便其他设备连接。"
          }
        }
      }
    },
    "accountKey.publishFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel konnte nicht hochgeladen werden. Beim nächsten Entsperren wird es erneut versucht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποστολή του κλειδιού κρυπτογράφησης. Θα γίνει νέα προσπάθεια στο επόμενο ξεκλείδωμα."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the encryption key. It will be tried again next time you unlock."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the encryption key. It will be tried again next time you unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir la clave de cifrado. Se volverá a intentar la próxima vez que desbloquee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer la clé de chiffrement. Une nouvelle tentative aura lieu au prochain déverrouillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la chiave di crittografia. Verrà fatto un nuovo tentativo al prossimo sblocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化キーをアップロードできませんでした。次回のロック解除時に再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화 키를 업로드할 수 없었습니다. 다음에 잠금 해제할 때 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel kon niet worden geüpload. Bij de volgende ontgrendeling wordt het opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przesłać klucza szyfrowania. Próba zostanie ponowiona przy następnym odblokowaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar a chave de encriptação. Será tentado novamente da próxima vez que desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить ключ шифрования. Попытка будет повторена при следующей разблокировке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreleme anahtarı yüklenemedi. Bir sonraki kilit açışınızda yeniden denenecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法上传加密密钥。下次解锁时会重试。"
          }
        }
      }
    },
