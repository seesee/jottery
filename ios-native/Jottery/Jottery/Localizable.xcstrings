    "health.unreadableFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese erscheinen nicht in Ihren Listen. Wenn Sie ein anderes Gerät verwenden, prüfen Sie dort, ob sie sich öffnen lassen, bevor Sie sie löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές δεν εμφανίζονται στις λίστες σας. Αν χρησιμοποιείτε άλλη συσκευή, ελέγξτε αν ανοίγουν εκεί πριν τις διαγράψετε."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These don't appear in your lists. If you use another device, check whether they open there before deleting them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "These don't appear in your lists. If you use another device, check whether they open there before deleting them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aparecen en sus listas. Si usa otro dispositivo, compruebe si se abren allí antes de eliminarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles n'apparaissent pas dans vos listes. Si vous utilisez un autre appareil, vérifiez si elles s'y ouvrent avant de les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appaiono nei tuoi elenchi. Se usi un altro dispositivo, controlla se si aprono lì prima di eliminarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはリストに表示されません。別のデバイスを使用している場合は、削除する前にそのデバイスで開けるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트는 목록에 표시되지 않습니다. 다른 기기를 사용하는 경우 삭제하기 전에 해당 기기에서 열리는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze verschijnen niet in je lijsten. Als je een ander apparaat gebruikt, controleer dan of ze daar wel openen voordat je ze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pojawiają się na Twoich listach. Jeśli korzystasz z innego urządzenia, przed usunięciem sprawdź, czy można je tam otworzyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aparecem nas suas listas. Se usa outro dispositivo, verifique se abrem lá antes de as excluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не отображаются в ваших списках. Если вы пользуетесь другим устройством, перед удалением проверьте, открываются ли они там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar listelerinizde görünmez. Başka bir cihaz kullanıyorsanız silmeden önce orada açılıp açılmadıklarını kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些笔记不会显示在你的列表中。如果你还使用其他设备，请在删除前检查能否在该设备上打开。"
          }
        }
      }
    },
