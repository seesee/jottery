    "envelopeError.cantOpenServerKey": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel des Kontos konnte mit dem Notizen-Passwort nicht geöffnet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί κρυπτογράφησης του λογαριασμού δεν ήταν δυνατό να ανοίξει με τον κωδικό σημειώσεων."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's encryption key could not be opened with the notes password."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's encryption key could not be opened with the notes password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la clave de cifrado de la cuenta con la contraseña de las notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir la clé de chiffrement du compte avec le mot de passe des notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la chiave di crittografia dell'account con la password delle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートのパスワードでアカウントの暗号化キーを開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 비밀번호로 계정의 암호화 키를 열 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel van het account kon niet worden geopend met het notitiewachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza szyfrowania konta nie można otworzyć hasłem do notatek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a chave de encriptação da conta com a palavra-passe das notas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ шифрования учётной записи не открывается паролем заметок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın şifreleme anahtarı not parolasıyla açılamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法用笔记密码打开账户的加密密钥。"
          }
        }
      }
    },
