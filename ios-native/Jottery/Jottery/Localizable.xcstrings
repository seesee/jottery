          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν αποδέχτηκε το κλειδί αυτής της συσκευής."
          }
        },
        "en-GB": {
          "stringUnit": {
