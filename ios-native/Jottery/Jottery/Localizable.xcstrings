    "vault.busy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Notizen werden neu verschlüsselt. Ihre Änderungen bleiben erhalten und werden gespeichert, sobald der Vorgang abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σας κρυπτογραφούνται εκ νέου. Οι αλλαγές σας διατηρούνται και θα αποθηκευτούν όταν ολοκληρωθεί η διαδικασία."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes are being re-encrypted. Your changes are kept, and will be saved when it's finished."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes are being re-encrypted. Your changes are kept, and will be saved when it's finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus notas se están volviendo a cifrar. Sus cambios se conservan y se guardarán cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes sont en cours de rechiffrement. Vos modifications sont conservées et seront enregistrées à la fin de l'opération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note sono in fase di nuova crittografia. Le modifiche vengono conservate e saranno salvate al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを再暗号化しています。変更内容は保持され、完了後に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 다시 암호화하는 중입니다. 변경 사항은 유지되며 완료되면 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notities worden opnieuw versleuteld. Je wijzigingen blijven bewaard en worden opgeslagen zodra dit klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki są ponownie szyfrowane. Zmiany zostały zachowane i zostaną zapisane po zakończeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas notas estão sendo encriptadas novamente. As suas alterações foram mantidas e serão salvas quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши заметки шифруются заново. Ваши изменения сохранены и будут записаны по завершении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınız yeniden şifreleniyor. Değişiklikleriniz korunuyor ve işlem bitince kaydedilecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新加密你的笔记。你的更改已保留，并会在完成后保存。"
          }
        }
      }
    },
