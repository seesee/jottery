            "value": "Was der Server gesendet hat, konnte nicht entschlüsselt werden und wurde daher nicht behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα έστειλε ο διακομιστής δεν ήταν δυνατό να αποκρυπτογραφηθούν, οπότε δεν διατηρήθηκαν."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the server sent couldn't be decrypted, so it wasn't kept."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What the server sent couldn't be decrypted, so it wasn't kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que envió el servidor no se pudo descifrar, así que no se conservó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le serveur a envoyé n'a pas pu être déchiffré et n'a donc pas été conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decrittografare i dati inviati dal server, quindi non sono stati conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから送信されたデータを復号できなかったため、保持しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 보낸 데이터를 복호화할 수 없어 유지하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de server stuurde kon niet worden ontsleuteld en is dus niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odszyfrować danych z serwera, więc nie zostały zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o servidor enviou não pôde ser desencriptado, por isso não foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, полученные с сервера, не удалось расшифровать, поэтому они не сохранены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun gönderdiği verilerin şifresi çözülemedi, bu yüzden korunmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密服务器发送的内容，因此未保留。"
          }
        }
      }
    },
