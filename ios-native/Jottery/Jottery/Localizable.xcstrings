    "envelopeError.noServerKey": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Konto gibt es noch keinen Verschlüsselungsschlüssel auf dem Server. Entsperren Sie Jottery auf einem bereits verbundenen Gerät und versuchen Sie es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός δεν έχει ακόμα κλειδί κρυπτογράφησης στον διακομιστή. Ξεκλειδώστε το Jottery σε μια συσκευή που είναι ήδη συνδεδεμένη και δοκιμάστε ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no encryption key on the server yet. Unlock Jottery on a device that's already connected, then try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no encryption key on the server yet. Unlock Jottery on a device that's already connected, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta aún no tiene clave de cifrado en el servidor. Desbloquee Jottery en un dispositivo que ya esté conectado y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'a pas encore de clé de chiffrement sur le serveur. Déverrouillez Jottery sur un appareil déjà connecté, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non ha ancora una chiave di crittografia sul server. Sblocca Jottery su un dispositivo già collegato, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの暗号化キーはまだサーバーにありません。すでに接続されているデバイスでJotteryのロックを解除してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 암호화 키가 아직 서버에 없습니다. 이미 연결된 기기에서 Jottery를 잠금 해제한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account heeft nog geen versleutelingssleutel op de server. Ontgrendel Jottery op een apparaat dat al is verbonden en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma jeszcze klucza szyfrowania na serwerze. Odblokuj Jottery na urządzeniu, które jest już połączone, a następnie spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta ainda não tem chave de encriptação no servidor. Desbloqueie o Jottery em um dispositivo que já esteja conectado e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой учётной записи пока нет ключа шифрования на сервере. Разблокируйте Jottery на уже подключённом устройстве, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın sunucuda henüz bir şifreleme anahtarı yok. Zaten bağlı bir cihazda Jottery'nin kilidini açın, ardından yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户在服务器上还没有加密密钥。请在已连接的设备上解锁 Jottery，然后重试。"
          }
        }
      }
    },
