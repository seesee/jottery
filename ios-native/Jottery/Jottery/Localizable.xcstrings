    "health.uploadNotKept": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dies nicht behalten. Das Bearbeiten der Notiz kann helfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν το διατήρησε. Η επεξεργασία της σημείωσης ίσως βοηθήσει."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't keep this. Editing the note may help."
