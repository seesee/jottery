    "syncEndpoint.insecurePublicHost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ würde Ihre Daten über eine unverschlüsselte Verbindung senden. Verwenden Sie https:// für einen Server im Internet. Einfaches http:// wird nur für Server in Ihrem lokalen Netzwerk unterstützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση «%@» θα έστελνε τα δεδομένα σας μέσω μη κρυπτογραφημένης σύνδεσης. Χρησιμοποιήστε https:// για διακομιστή στο διαδίκτυο. Το απλό http:// υποστηρίζεται μόνο για διακομιστές στο τοπικό σας δίκτυο."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” would send your data over an unencrypted connection. Use https:// for a server on the internet. Plain http:// is only supported for servers on your local network."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” would send your data over an unencrypted connection. Use https:// for a server on the internet. Plain http:// is only supported for servers on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” enviaría sus datos a través de una conexión sin cifrar. Use https:// para un servidor en internet. http:// solo se admite para servidores de su red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » enverrait vos données via une connexion non chiffrée. Utilisez https:// pour un serveur sur Internet. http:// n'est pris en charge que pour les serveurs de votre réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” invierebbe i tuoi dati tramite una connessione non crittografata. Usa https:// per un server su internet. Il semplice http:// è supportato solo per i server sulla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」では、暗号化されていない接続でデータが送信されます。インターネット上のサーバーにはhttps://を使用してください。http://は、ローカルネットワーク上のサーバーでのみサポートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 암호화되지 않은 연결로 데이터를 보냅니다. 인터넷상의 서버에는 https://를 사용하세요. 일반 http://는 로컬 네트워크의 서버에서만 지원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” zou je gegevens via een onversleutelde verbinding versturen. Gebruik https:// voor een server op het internet. Gewoon http:// wordt alleen ondersteund voor servers op je lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” wysyłałby Twoje dane przez niezaszyfrowane połączenie. Dla serwera w internecie użyj https://. Zwykły http:// jest obsługiwany tylko dla serwerów w Twojej sieci lokalnej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” enviaria os seus dados por uma conexão não encriptada. Use https:// para um servidor na internet. O http:// simples só é compatível com servidores na sua rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» отправлял бы ваши данные по незашифрованному соединению. Для сервера в интернете используйте https://. Обычный http:// поддерживается только для серверов в вашей локальной сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adresi verilerinizi şifresiz bir bağlantı üzerinden gönderir. İnternetteki bir sunucu için https:// kullanın. Düz http:// yalnızca yerel ağınızdaki sunucular için desteklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”会通过未加密的连接发送你的数据。互联网上的服务器请使用 https://。仅本地网络上的服务器支持普通 http://。"
          }
        }
      }
    },
    "syncEndpoint.insecureStored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse Ihres Synchronisationsservers verwendet http:// über das Internet, was nicht mehr zulässig ist. Aktualisieren Sie sie in den Einstellungen auf https://."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση του διακομιστή συγχρονισμού σας χρησιμοποιεί http:// μέσω διαδικτύου, κάτι που δεν επιτρέπεται πλέον. Αλλάξτε την σε https:// στις Ρυθμίσεις."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sync server address uses http:// over the internet, which is no longer permitted. Update it to https:// in Settings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sync server address uses http:// over the internet, which is no longer permitted. Update it to https:// in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de su servidor de sincronización usa http:// por internet, algo que ya no se permite. Actualícela a https:// en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse de votre serveur de synchronisation utilise http:// sur Internet, ce qui n'est plus autorisé. Remplacez-la par https:// dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo del server di sincronizzazione usa http:// su internet, che non è più consentito. Aggiornalo a https:// nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期サーバーのアドレスがインターネット上でhttp://を使用していますが、これは許可されなくなりました。設定でhttps://に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 서버 주소가 인터넷에서 http://를 사용하고 있으며, 이는 더 이상 허용되지 않습니다. 설정에서 https://로 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres van je synchronisatieserver gebruikt http:// via het internet, wat niet langer is toegestaan. Wijzig het in https:// in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres Twojego serwera synchronizacji używa http:// przez internet, co nie jest już dozwolone. Zmień go na https:// w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do seu servidor de sincronização usa http:// pela internet, o que já não é permitido. Atualize-o para https:// nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес вашего сервера синхронизации использует http:// через интернет, что больше не разрешено. Измените его на https:// в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronizasyon sunucusu adresiniz internet üzerinden http:// kullanıyor ve buna artık izin verilmiyor. Ayarlar'dan https:// olarak güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的同步服务器地址在互联网上使用了 http://，这已不再被允许。请在“设置”中将其更新为 https://。"
          }
        }
      }
    },
    "syncEndpoint.malformed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist keine gültige Serveradresse. Verwenden Sie eine Form wie https://notes.example.org"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν είναι έγκυρη διεύθυνση διακομιστή. Χρησιμοποιήστε μια μορφή όπως https://notes.example.org"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid server address. Use a form like https://notes.example.org"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid server address. Use a form like https://notes.example.org"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es una dirección de servidor válida. Use un formato como https://notes.example.org"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'est pas une adresse de serveur valide. Utilisez une forme comme https://notes.example.org"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un indirizzo del server valido. Usa un formato come https://notes.example.org"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は有効なサーバーアドレスではありません。https://notes.example.org のような形式で入力してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 올바른 서버 주소가 아닙니다. https://notes.example.org와 같은 형식을 사용하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is geen geldig serveradres. Gebruik een notatie als https://notes.example.org"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest prawidłowym adresem serwera. Użyj postaci takiej jak https://notes.example.org"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um endereço de servidor válido. Use um formato como https://notes.example.org"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — недопустимый адрес сервера. Используйте формат вида https://notes.example.org"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” geçerli bir sunucu adresi değil. https://notes.example.org gibi bir biçim kullanın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的服务器地址。请使用类似 https://notes.example.org 的形式"
          }
        }
      }
    },
    "syncError.accountDisabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde deaktiviert, daher wurde die Synchronisation gestoppt. Ihre Notizen auf diesem Gerät sind sicher, und die Synchronisation wird fortgesetzt, sobald das Konto wieder aktiviert wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός έχει απενεργοποιηθεί, οπότε ο συγχρονισμός σταμάτησε. Οι σημειώσεις σας σε αυτή τη συσκευή είναι ασφαλείς και ο συγχρονισμός θα συνεχιστεί αν ο λογαριασμός ενεργοποιηθεί ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has been deactivated, so sync has stopped. Your notes on this device are safe, and sync carries on if the account is reactivated."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has been deactivated, so sync has stopped. Your notes on this device are safe, and sync carries on if the account is reactivated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se ha desactivado, por lo que la sincronización se ha detenido. Sus notas en este dispositivo están a salvo y la sincronización continuará si la cuenta se reactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte a été désactivé, la synchronisation est donc arrêtée. Vos notes sur cet appareil sont en sécurité et la synchronisation reprendra si le compte est réactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account è stato disattivato, quindi la sincronizzazione si è interrotta. Le note su questo dispositivo sono al sicuro e la sincronizzazione riprende se l'account viene riattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは無効化されているため、同期が停止しました。このデバイス上のノートは安全で、アカウントが再び有効になると同期が再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정이 비활성화되어 동기화가 중단되었습니다. 이 기기의 노트는 안전하며, 계정이 다시 활성화되면 동기화가 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account is gedeactiveerd, dus de synchronisatie is gestopt. Je notities op dit apparaat zijn veilig, en de synchronisatie gaat verder als het account weer wordt geactiveerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto zostało dezaktywowane, więc synchronizacja została zatrzymana. Twoje notatki na tym urządzeniu są bezpieczne, a synchronizacja będzie kontynuowana, jeśli konto zostanie ponownie aktywowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta foi desativada, por isso a sincronização parou. As suas notas neste dispositivo estão seguras e a sincronização continua se a conta for reativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учётная запись деактивирована, поэтому синхронизация остановлена. Ваши заметки на этом устройстве в безопасности, а синхронизация продолжится, если учётную запись снова активируют."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap devre dışı bırakıldı, bu yüzden senkronizasyon durdu. Bu cihazdaki notlarınız güvende ve hesap yeniden etkinleştirilirse senkronizasyon devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已被停用，因此同步已停止。你在此设备上的笔记是安全的，如果账户重新启用，同步将继续。"
          }
        }
      }
    },
    "syncError.accountExists": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese E-Mail-Adresse existiert bereits ein Konto. Wählen Sie „Ich habe ein Konto“, um dieses Gerät damit zu verbinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η διεύθυνση email έχει ήδη λογαριασμό. Επιλέξτε «Έχω λογαριασμό» για να συνδέσετε αυτή τη συσκευή σε αυτόν."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This email address already has an account. Choose “I Have an Account” to connect this device to it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This email address already has an account. Choose “I Have an Account” to connect this device to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección de correo electrónico ya tiene una cuenta. Elija “Ya tengo una cuenta” para conectar este dispositivo a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail possède déjà un compte. Choisissez « J'ai un compte » pour y connecter cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo email ha già un account. Scegli “Ho un account” per collegarvi questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスのアカウントはすでに存在します。「アカウントを持っている」を選んで、このデバイスを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일 주소로 이미 계정이 있습니다. “계정이 있습니다”를 선택하여 이 기기를 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit e-mailadres heeft al een account. Kies “Ik heb een account” om dit apparaat ermee te verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres e-mail ma już konto. Wybierz „Mam konto”, aby połączyć z nim to urządzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço de e-mail já tem uma conta. Escolha “Já tenho uma conta” para conectar este dispositivo a ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого адреса электронной почты уже есть учётная запись. Выберите «У меня есть учётная запись», чтобы подключить к ней это устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta adresinin zaten bir hesabı var. Bu cihazı hesaba bağlamak için “Hesabım Var” seçeneğini belirleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电子邮件地址已有账户。请选择“我已有账户”，将此设备连接到该账户。"
          }
        }
      }
    },
    "syncError.accountPending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wartet auf die Genehmigung durch einen Administrator."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός αναμένει έγκριση από διαχειριστή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is waiting for an administrator to approve it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is waiting for an administrator to approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está esperando la aprobación de un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte attend l'approbation d'un administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account è in attesa dell'approvazione di un amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは管理者の承認待ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 관리자의 승인을 기다리고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account wacht op goedkeuring van een beheerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto czeka na zatwierdzenie przez administratora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta está à espera de aprovação por um administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учётная запись ожидает одобрения администратора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap bir yöneticinin onayını bekliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户正在等待管理员批准。"
          }
        }
      }
    },
    "syncError.clockAhead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Änderungen wurden nicht synchronisiert, weil ihr Datum mehr als einen Tag vor der Serverzeit liegt. Prüfen Sie Datum und Uhrzeit auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες αλλαγές δεν συγχρονίστηκαν, επειδή η ημερομηνία τους είναι πάνω από μία ημέρα μπροστά από τον διακομιστή. Ελέγξτε την ημερομηνία και την ώρα αυτής της συσκευής."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes weren't synced because they're dated more than a day ahead of the server. Check the date and time on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes weren't synced because they're dated more than a day ahead of the server. Check the date and time on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos cambios no se han sincronizado porque su fecha va más de un día por delante del servidor. Comprueba la fecha y la hora de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications n'ont pas été synchronisées, car leur date a plus d'un jour d'avance sur le serveur. Vérifiez la date et l'heure de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune modifiche non sono state sincronizzate perché la loro data è avanti di più di un giorno rispetto al server. Controlla la data e l'ora di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付がサーバーより1日以上先になっているため、一部の変更を同期できませんでした。このデバイスの日付と時刻を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜가 서버보다 하루 이상 앞서 있어 일부 변경 사항이 동기화되지 않았습니다. 이 기기의 날짜와 시간을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige wijzigingen zijn niet gesynchroniseerd, omdat hun datum meer dan een dag op de server voorloopt. Controleer de datum en tijd op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre zmiany nie zostały zsynchronizowane, ponieważ ich data wyprzedza serwer o ponad jeden dzień. Sprawdź datę i godzinę na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas alterações não foram sincronizadas porque a sua data está mais de um dia à frente do servidor. Verifique a data e a hora deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые изменения не синхронизированы: их дата опережает сервер более чем на сутки. Проверьте дату и время на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihleri sunucunun bir günden fazla ilerisinde olduğu için bazı değişiklikler eşitlenmedi. Bu cihazın tarih ve saatini kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改未能同步，因为其日期比服务器提前了一天以上。请检查此设备的日期和时间。"
          }
        }
      }
    },
    "syncError.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Servers konnte nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση της απάντησης του διακομιστή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's response couldn't be read."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's response couldn't be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la respuesta del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la réponse du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la risposta del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord van de server kon niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać odpowiedzi serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a resposta do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ответ сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun yanıtı okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取服务器的响应。"
          }
        }
      }
    },
    "syncError.keyChanged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel des Kontos hat sich gerade geändert. Versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί κρυπτογράφησης του λογαριασμού μόλις άλλαξε. Δοκιμάστε ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's encryption key has just changed. Try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's encryption key has just changed. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado de la cuenta acaba de cambiar. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement du compte vient de changer. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di crittografia dell'account è appena cambiata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの暗号化キーが変更されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 암호화 키가 방금 변경되었습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel van het account is zojuist gewijzigd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz szyfrowania konta właśnie się zmienił. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de encriptação da conta acabou de mudar. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ шифрования учётной записи только что изменился. Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın şifreleme anahtarı az önce değişti. Yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户的加密密钥刚刚发生了变化。请重试。"
          }
        }
      }
    },
    "syncError.noApiKey": {
