            "value": "Im Papierkorb lassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραμονή στον κάδο"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave in Bin"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave in Bin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar en la papelera"
          }
        },
        "fr": {
