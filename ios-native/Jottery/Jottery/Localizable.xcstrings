    "setup.encryptionPasswordHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie dasselbe Verschlüsselungspasswort ein, das Sie auf Ihren anderen Geräten verwenden. Wählen Sie auf Ihrem ersten Gerät eines mit mindestens 8 Zeichen. Es muss sich von Ihrem Server-Passwort unterscheiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον ίδιο κωδικό κρυπτογράφησης που χρησιμοποιείτε στις άλλες συσκευές σας. Στην πρώτη σας συσκευή, επιλέξτε έναν με τουλάχιστον 8 χαρακτήρες. Πρέπει να διαφέρει από τον κωδικό διακομιστή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the same encryption password used on your other devices. On your first device, choose one of at least 8 characters. It must be different from your server password."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the same encryption password used on your other devices. On your first device, choose one of at least 8 characters. It must be different from your server password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese la misma contraseña de cifrado que usa en sus otros dispositivos. En su primer dispositivo, elija una de al menos 8 caracteres. Debe ser distinta de su contraseña del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le même mot de passe de chiffrement que sur vos autres appareils. Sur votre premier appareil, choisissez-en un d'au moins 8 caractères. Il doit être différent de votre mot de passe du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la stessa password di crittografia usata sugli altri dispositivi. Sul primo dispositivo, scegline una di almeno 8 caratteri. Deve essere diversa dalla password del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスで使用している暗号化パスワードと同じものを入力してください。最初のデバイスでは、8文字以上のパスワードを設定します。サーバーパスワードとは異なるものにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 사용하는 것과 같은 암호화 비밀번호를 입력하세요. 첫 번째 기기에서는 8자 이상으로 정하세요. 서버 비밀번호와 달라야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer hetzelfde versleutelingswachtwoord in als op je andere apparaten. Kies op je eerste apparaat een wachtwoord van minstens 8 tekens. Het moet verschillen van je serverwachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz to samo hasło szyfrowania, którego używasz na innych urządzeniach. Na pierwszym urządzeniu wybierz hasło mające co najmniej 8 znaków. Musi się ono różnić od hasła serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a mesma palavra-passe de encriptação usada nos seus outros dispositivos. No primeiro dispositivo, escolha uma com pelo menos 8 caracteres. Tem de ser diferente da palavra-passe do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите тот же пароль шифрования, что и на других ваших устройствах. На первом устройстве выберите пароль не короче 8 символов. Он должен отличаться от пароля сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazlarınızda kullandığınız şifreleme parolasının aynısını girin. İlk cihazınızsa en az 8 karakterli bir parola seçin. Sunucu şifrenizden farklı olmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你在其他设备上使用的同一加密密码。在第一台设备上，请选择至少 8 个字符的密码。它必须与你的服务器密码不同。"
          }
        }
      }
    },
