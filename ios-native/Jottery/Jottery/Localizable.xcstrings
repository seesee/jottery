    "unlock.biometricOutOfDate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID muss aktualisiert werden. Entsperren Sie diesmal mit Ihrem Passwort, dann funktioniert Face ID wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Face ID χρειάζεται ενημέρωση. Ξεκλειδώστε αυτή τη φορά με τον κωδικό σας και το Face ID θα λειτουργήσει ξανά."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID needs updating. Unlock with your password this time and Face ID will work again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID needs updating. Unlock with your password this time and Face ID will work again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID necesita actualizarse. Desbloquee con su contraseña esta vez y Face ID volverá a funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID doit être mis à jour. Déverrouillez avec votre mot de passe cette fois, et Face ID fonctionnera à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID deve essere aggiornato. Questa volta sblocca con la password e Face ID tornerà a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDの更新が必要です。今回はパスワードでロック解除すると、Face IDが再び使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID를 업데이트해야 합니다. 이번에는 비밀번호로 잠금 해제하면 Face ID를 다시 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID moet worden bijgewerkt. Ontgrendel deze keer met je wachtwoord, dan werkt Face ID weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID wymaga aktualizacji. Tym razem odblokuj hasłem, a Face ID znowu będzie działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Face ID precisa ser atualizado. Desbloqueie com a sua senha desta vez e o Face ID voltará a funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID нужно обновить. В этот раз разблокируйте паролем, и Face ID снова заработает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID'nin güncellenmesi gerekiyor. Bu kez kilidi şifrenizle açın, Face ID yeniden çalışacaktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 需要更新。这次请用密码解锁，Face ID 随后即可再次使用。"
          }
        }
      }
    },
