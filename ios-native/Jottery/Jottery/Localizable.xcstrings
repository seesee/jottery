    "error.couldntSaveNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz konnte nicht gespeichert werden. Ihre Änderungen bleiben erhalten, das Speichern wird erneut versucht."
          }
