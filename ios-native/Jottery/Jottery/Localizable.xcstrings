    "health.missingFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft jeden Anhang von Ihrem Synchronisationsserver ab. Falls der Server ihn ebenfalls nicht hat, öffnen Sie die Notiz und entfernen Sie den Anhang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανακτά κάθε συνημμένο από τον διακομιστή συγχρονισμού σας. Αν δεν το έχει ούτε ο διακομιστής, ανοίξτε τη σημείωση και αφαιρέστε το συνημμένο."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches each one from your sync server. If the server doesn't have one either, open the note and remove the attachment."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches each one from your sync server. If the server doesn't have one either, open the note and remove the attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera cada uno de su servidor de sincronización. Si el servidor tampoco lo tiene, abra la nota y quite el archivo adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère chacune d'elles depuis votre serveur de synchronisation. Si le serveur ne l'a pas non plus, ouvrez la note et retirez la pièce jointe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera ogni allegato dal server di sincronizzazione. Se non è presente nemmeno sul server, apri la nota e rimuovi l'allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれを同期サーバーから取得します。サーバーにもない場合は、ノートを開いて添付ファイルを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 첨부파일을 동기화 서버에서 가져옵니다. 서버에도 없는 경우 노트를 열어 첨부파일을 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt elke bijlage op van je synchronisatieserver. Als de server die ook niet heeft, open je de notitie en verwijder je de bijlage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera każdy załącznik z Twojego serwera synchronizacji. Jeśli serwer też go nie ma, otwórz notatkę i usuń załącznik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera cada um do seu servidor de sincronização. Se o servidor também não o tiver, abra a nota e remova o anexo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получает каждое вложение с вашего сервера синхронизации. Если на сервере его тоже нет, откройте заметку и удалите вложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her eki senkronizasyon sunucunuzdan getirir. Sunucuda da yoksa notu açın ve eki kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的同步服务器获取每个附件。如果服务器上也没有，请打开笔记并移除该附件。"
          }
        }
      }
    },
    "health.missingFooterNoSync": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich mit einem Synchronisationsserver, um sie abzurufen, oder öffnen Sie jede Notiz und entfernen Sie den Anhang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε σε διακομιστή συγχρονισμού για να τα ανακτήσετε ή ανοίξτε κάθε σημείωση και αφαιρέστε το συνημμένο."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a sync server to fetch these, or open each note and remove the attachment."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a sync server to fetch these, or open each note and remove the attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctese a un servidor de sincronización para recuperarlos, o abra cada nota y quite el archivo adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur de synchronisation pour les récupérer, ou ouvrez chaque note et retirez la pièce jointe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a un server di sincronizzazione per recuperarli, oppure apri ogni nota e rimuovi l'allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期サーバーに接続して取得するか、各ノートを開いて添付ファイルを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 서버에 연결하여 가져오거나, 각 노트를 열어 첨부파일을 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met een synchronisatieserver om deze op te halen, of open elke notitie en verwijder de bijlage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z serwerem synchronizacji, aby je pobrać, lub otwórz każdą notatkę i usuń załącznik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor de sincronização para os recuperar, ou abra cada nota e remova o anexo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу синхронизации, чтобы получить их, или откройте каждую заметку и удалите вложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları getirmek için bir senkronizasyon sunucusuna bağlanın veya her notu açıp eki kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到同步服务器以获取这些附件，或打开每条笔记并移除附件。"
          }
        }
      }
    },
