    "vaultReKeyError.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Tresors konnte nicht neu verschlüsselt werden, daher wurde nichts geändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι στο θησαυροφυλάκιο δεν μπόρεσε να κρυπτογραφηθεί εκ νέου, οπότε δεν άλλαξε τίποτα."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in the vault couldn't be re-encrypted, so nothing was changed."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in the vault couldn't be re-encrypted, so nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo de la bóveda no se pudo volver a cifrar, así que no se ha cambiado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du coffre n'a pas pu être rechiffrée ; rien n'a donc été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile crittografare di nuovo qualcosa nella cassaforte, quindi non è stato modificato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫内の一部を再暗号化できなかったため、何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고의 일부 항목을 다시 암호화할 수 없어 아무것도 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets in de kluis kon niet opnieuw worden versleuteld, dus er is niets gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ponownie zaszyfrować części zawartości sejfu, więc nic nie zostało zmienione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo no cofre não pôde ser encriptado novamente, por isso nada foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть данных хранилища не удалось зашифровать заново, поэтому ничего не изменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki bir şey yeniden şifrelenemedi, bu yüzden hiçbir şey değiştirilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库中的部分内容无法重新加密，因此未做任何更改。"
          }
        }
      }
    },
