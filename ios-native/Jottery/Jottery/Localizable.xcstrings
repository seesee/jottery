    "settings.wipeConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Datenbank, alle Notizen, Verschlüsselungsschlüssel und Synchronisationszugangsdaten gelöscht. Sie müssen einen neuen Tresor einrichten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφούν η βάση δεδομένων, όλες οι σημειώσεις, τα κλειδιά κρυπτογράφησης και τα διαπιστευτήρια συγχρονισμού. Θα πρέπει να ρυθμίσετε ένα νέο θησαυροφυλάκιο. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the database, all notes, encryption keys, and sync credentials. You will need to set up a new vault. This cannot be undone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the database, all notes, encryption keys, and sync credentials. You will need to set up a new vault. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la base de datos, todas las notas, las claves de cifrado y las credenciales de sincronización. Tendrá que configurar una bóveda nueva. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la base de données, toutes les notes, les clés de chiffrement et les identifiants de synchronisation. Vous devrez configurer un nouveau coffre. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati il database, tutte le note, le chiavi di crittografia e le credenziali di sincronizzazione. Dovrai configurare una nuova cassaforte. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベース、すべてのノート、暗号化キー、同期の認証情報が削除されます。新しい保管庫を設定する必要があります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스, 모든 노트, 암호화 키, 동기화 자격 증명이 삭제됩니다. 새 금고를 설정해야 합니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert de database, alle notities, versleutelingssleutels en synchronisatie-inloggegevens. Je moet een nieuwe kluis aanmaken. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie bazy danych, wszystkich notatek, kluczy szyfrowania i danych logowania do synchronizacji. Konieczne będzie utworzenie nowego sejfu. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina o banco de dados, todas as notas, as chaves de encriptação e as credenciais de sincronização. Será necessário configurar um novo cofre. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены база данных, все заметки, ключи шифрования и учётные данные синхронизации. Вам потребуется создать новое хранилище. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem veritabanını, tüm notları, şifreleme anahtarlarını ve senkronizasyon kimlik bilgilerini siler. Yeni bir kasa kurmanız gerekecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除数据库、所有笔记、加密密钥和同步凭据。你需要设置新的保险库。此操作无法撤销。"
          }
        }
      }
    },
