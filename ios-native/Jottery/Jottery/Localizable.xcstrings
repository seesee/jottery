    "syncMerge.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen nicht möglich: Einige Notizen dieses Geräts konnten nicht neu verschlüsselt werden. Auf diesem Gerät wurde nichts geändert, und es ist dem Konto nicht beigetreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συγχώνευση δεν ήταν δυνατή: ορισμένες σημειώσεις αυτής της συσκευής δεν μπόρεσαν να κρυπτογραφηθούν εκ νέου. Δεν άλλαξε τίποτα σε αυτή τη συσκευή και δεν έχει συνδεθεί στον λογαριασμό."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't merge: some of this device's notes couldn't be re-encrypted. Nothing on this device has been changed, and it hasn't joined the account."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't merge: some of this device's notes couldn't be re-encrypted. Nothing on this device has been changed, and it hasn't joined the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo combinar: algunas notas de este dispositivo no se pudieron volver a cifrar. No se ha cambiado nada en este dispositivo y no se ha unido a la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusion impossible : certaines notes de cet appareil n'ont pas pu être rechiffrées. Rien n'a été modifié sur cet appareil, et il n'a pas rejoint le compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eseguire l'unione: non è stato possibile crittografare di nuovo alcune note di questo dispositivo. Non è stato modificato nulla su questo dispositivo, che non è stato collegato all'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージできませんでした。このデバイスの一部のノートを再暗号化できませんでした。このデバイスの内容は何も変更されておらず、アカウントにも参加していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합할 수 없었습니다. 이 기기의 일부 노트를 다시 암호화할 수 없었습니다. 이 기기의 내용은 변경되지 않았으며 계정에 참여하지도 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen mislukt: sommige notities op dit apparaat konden niet opnieuw worden versleuteld. Er is niets op dit apparaat gewijzigd en het is niet aan het account toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się scalić: nie można było ponownie zaszyfrować niektórych notatek z tego urządzenia. Nic na tym urządzeniu nie zostało zmienione, a urządzenie nie dołączyło do konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mesclar: algumas notas deste dispositivo não puderam ser encriptadas novamente. Nada foi alterado neste dispositivo e ele não ingressou na conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось объединить: некоторые заметки этого устройства не удалось зашифровать заново. На этом устройстве ничего не изменено, и оно не присоединилось к учётной записи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirilemedi: Bu cihazdaki bazı notlar yeniden şifrelenemedi. Bu cihazda hiçbir şey değiştirilmedi ve cihaz hesaba katılmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法合并：此设备上的部分笔记无法重新加密。此设备上的内容未做任何更改，也未加入该账户。"
          }
        }
      }
    },
