#!/usr/bin/perl
use strict;
use warnings;
use JSON;

my $file = $ARGV[0] or die "Usage: $0 <json_file>\n";

open my $fh, '<', $file or die "Cannot open $file: $!\n";
my $json_text = do { local $/; <$fh> };
close $fh;

my $json = JSON->new->utf8->pretty->canonical;
my $data = $json->decode($json_text);

foreach my $note (@{$data->{notes}}) {
  my @attachments = @{$note->{attachments}};
  my $content = $note->{content};
  
  my $index = 0;
  $content =~ s/!\[attachment\]\(attachment:[^\)]+\)/
    $index < @attachments
      ? "![attachment](attachment:" . $attachments[$index++]->{filename} . ")"
      : $&
  /ge;
  
  my @matches;
  while ($content =~ /\[([^\]]+)\]\((https:\/\/ift\.tt\/[^\)]+)\)/g) {
    push @matches, { text => $1, url => $2 };
  }
  
  foreach my $match (@matches) {
    my $result = `perl summarise-url.pl "$match->{url}" 2>/dev/null`;
    chomp($result);
    
    my $replacement = "[$match->{text}]($match->{url})";
    
    if ($result && $result =~ /^\{/) {
      my $parsed = eval { $json->decode($result) };
      if ($parsed && $parsed->{url}) {
        my @new_tags = @{$parsed->{tags} // []};
        push @{$note->{tags}}, @new_tags;
        $replacement = "[$match->{text}]($parsed->{url})";
      } else {
        push @{$note->{tags}}, "url-failed";
      }
    } else {
      push @{$note->{tags}}, "url-failed";
    }
    
    $content =~ s/\Q[$match->{text}]($match->{url})\E/$replacement/;
  }
  
  $note->{content} = $content;
  
  if ($note->{syntaxLanguage} eq "markdown") {
    $note->{showPreview} = JSON::true;
  }
}

open $fh, '>', $file or die "Cannot write to $file: $!\n";
print $fh $json->encode($data);
close $fh;

print "Updated $file\n";
