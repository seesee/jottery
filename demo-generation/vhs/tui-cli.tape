# Jottery TUI - CLI Commands
Output public/screenshots/en-GB/tui-cli.gif

Set FontSize 18
Set Width 1400
Set Height 900
Set Theme "Catppuccin Mocha"
Set Shell "bash"

# Navigate to the executable directory
Type "cd tui/target/release"
Enter
Sleep 500ms

# Run the help command
Type "./jottery --help"
Enter
Sleep 6s
