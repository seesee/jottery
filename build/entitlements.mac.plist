<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the app to run with hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <!-- Network access for sync functionality -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Keychain access for secure password storage -->
    <key>com.apple.security.keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)io.jottery.app</string>
    </array>

    <!-- File access (user-selected via native dialogs) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow app to inherit entitlements (for child processes like auto-updater) -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
