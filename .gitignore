# Android build artifacts
android-native/.gradle/
android-native/app/build/
android-native/app/schemas/
android-native/build/
android-native/local.properties

# Server runtime database
jottery.db
# ...including SQLite sidecars and any dated/branch-suffixed copies kept around
# during development. Without these, `git add -A` sweeps a multi-hundred-MB dev
# database into a commit and the push is rejected by GitHub's 100 MB file limit.
jottery.db-*
jottery.db.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
