<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Security: do not back up any app data -->
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device-to-device transfer of shared prefs only (settings) -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
