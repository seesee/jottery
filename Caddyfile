:8088 {
	root * /app/dist
	file_server

	# Proxy API, admin, and user routes to backend server
	reverse_proxy /api* localhost:3030
	reverse_proxy /admin* localhost:3030
	reverse_proxy /user* localhost:3030

	# Clean URL for the privacy policy (also linked from the iOS app)
	rewrite /privacy /privacy.html

	# SPA fallback for web UI
	@notStatic {
		not path /api*
		not path /admin*
		not path /user*
		not file
	}
	rewrite @notStatic /index.html
}
