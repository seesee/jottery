:8088 {
	# Proxy API, admin, and user routes to jottery-server
	handle /api/* {
		reverse_proxy localhost:3030
	}
	handle /admin/* {
		reverse_proxy localhost:3030
	}
	handle /user/* {
		reverse_proxy localhost:3030
	}

	# Web UI (default)
	handle {
		root * /app/dist
		try_files {path} /index.html
		file_server
	}
}
