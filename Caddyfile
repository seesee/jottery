:8088 {
	# API proxy to jottery-server
	reverse_proxy /api/* localhost:3030

	# Admin dashboard - strip prefix and serve static files
	handle_path /admin/* {
		root * /app/admin/dist
		try_files {path} /index.html
		file_server
	}

	# User portal - strip prefix and serve static files
	handle_path /user/* {
		root * /app/admin/dist
		try_files {path} /index.html
		file_server
	}

	# Web UI (default)
	root * /app/dist
	try_files {path} /index.html
	file_server
}
