{
  "name": "jottery-webview-bundles",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained HTML bundles for iOS WKWebView editors",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && BUNDLE=preview vite build && BUNDLE=calc vite build && BUNDLE=outliner vite build && node scripts/add-csp.mjs dist/preview.html",
    "build:preview": "BUNDLE=preview vite build",
    "build:calc": "BUNDLE=calc vite build",
    "build:outliner": "BUNDLE=outliner vite build",
    "dev": "vite"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.7",
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
