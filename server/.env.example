# Jottery Server Configuration
# Copy this file to .env and customize for your deployment

# Database connection string
# Default: sqlite:jottery.db
DATABASE_URL=sqlite:jottery.db

# Server port
# Default: 3030
PORT=3030

# Largest sync push, in bytes. Other routes have small fixed limits, and each user's
# own upload limit still applies. Lowering it can stop large syncs with a 413.
# Default: 104857600 (100 MB)
MAX_PAYLOAD_SIZE=104857600

# CORS Allowed Origins (comma-separated list)
# If not set, only the server's own origin can call it from a browser.
# Set this when the web client is served from somewhere else. * allows any origin.
#
# Examples:
#   Single origin:    https://jottery.example.com
#   Multiple origins: https://jottery.example.com,https://app.example.com
#   Development:      http://localhost:5173,http://127.0.0.1:5173
#
# SECURITY: Always use HTTPS origins in production!
# CORS_ALLOWED_ORIGINS=https://jottery.example.com

# ===== Security Settings =====

# Session expiry duration (in days)
# Default: 1
# Sessions older than this will be invalid
SESSION_EXPIRY_DAYS=1

# Send Strict-Transport-Security. Set to true only when clients reach the site over
# HTTPS, because browsers then refuse plain HTTP for a year.
# Default: false
ENABLE_HSTS=false

# Character classes a password needs, on top of the 12-character minimum:
# none, basic (2), standard (3) or strong (4)
# Default: standard
PASSWORD_COMPLEXITY=standard

# Admin account credentials
# Applied at startup while the admin account hasn't been configured yet.
# If the password is unset, the server generates a random one and prints it once
# in its log, and it must be changed at first sign-in. It must meet the password
# policy below; a weak value is ignored with a warning.
DEFAULT_ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=

# Password Hashing Parameters (Argon2id)
# These control the computational cost of password hashing
# Higher values = more secure but slower
#
# ARGON2_M_COST: Memory cost in KiB (default: 19456 = 19 MiB)
# ARGON2_T_COST: Time cost / iterations (default: 2)
# ARGON2_P_COST: Parallelism / threads (default: 1)
#
# Recommended values for production:
#   Low security:  m=19456, t=2,  p=1  (~50ms on modern CPU)
#   Medium:        m=65536, t=3,  p=1  (~200ms)
#   High:          m=262144, t=4, p=1  (~1s)
#
# SECURITY: Higher values provide better protection against brute-force attacks
ARGON2_M_COST=19456
ARGON2_T_COST=2
ARGON2_P_COST=1

# ===== User Settings =====

# Default storage quota for new users (in MB)
# Default: 1000 (1 GB)
DEFAULT_STORAGE_QUOTA_MB=1000

# Default upload limit for new users (in MB)
# Default: 5
DEFAULT_MAX_UPLOAD_SIZE_MB=5

# Default inbox capacity for new users
# Default: 100 items, 10 MB
DEFAULT_INBOX_MAX_ITEMS=100
DEFAULT_INBOX_MAX_SIZE_MB=10

# Refuse pushes that would take an account past its quota. Check accounts in the
# dashboard before turning this on: quotas weren't enforced before, so one may
# already be over, and a refused push stops that device's sync until it makes room.
# Default: false
ENFORCE_STORAGE_QUOTA=false

# How often, in seconds, an open event stream checks that its device hasn't been
# revoked. A revoked device can go on hearing when the user syncs for this long.
# Default: 60
SSE_RECHECK_SECS=60

# ===== Input Limits =====

# Anything longer is refused
# Device name, in characters. Default: 255
MAX_DEVICE_NAME_LENGTH=255
# One inbox item, in bytes. Default: 1048576 (1 MB)
MAX_INBOX_CONTENT_SIZE=1048576
# One note's encrypted content, in bytes. Default: 10485760 (10 MB)
MAX_NOTE_CONTENT_SIZE=10485760
# One tag, in characters. Default: 100
MAX_TAG_LENGTH=100
# Tags on one note. Default: 50
MAX_TAGS_PER_NOTE=50

# ===== Rate Limiting =====

# Sign-in and registration are limited per client address, and password attempts
# are also limited per email address with exponential backoff. Device sync isn't
# affected, because it uses API keys.

# How many proxies in front of this server append to X-Forwarded-For.
# 0 ignores the header, because any client can send one, and uses the connection's
# address. Behind a proxy that makes every client share one limit, so set this to
# the number of proxies you run. Set it too high and clients can forge their address.
# The Docker image sets 1 for its bundled Caddy.
# Default: 0
TRUSTED_PROXY_HOPS=0

# Turn all of this off, for example if your proxy already does it.
# Default: true
RATE_LIMIT_ENABLED=true

# Sign-in, device registration and device cloning, per address per minute.
# Default: 20
RATE_LIMIT_AUTH_PER_MINUTE=20

# Account registration, per address per hour.
# Default: 20
RATE_LIMIT_REGISTER_PER_HOUR=20

# Approval status checks, per address per minute.
# Default: 60
RATE_LIMIT_STATUS_PER_MINUTE=60

# Logging level (trace, debug, info, warn, error)
# Set via RUST_LOG environment variable
# Default: info
# RUST_LOG=info
