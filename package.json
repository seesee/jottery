{
  "name": "jottery",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.js",
  "overrides": {
    "esbuild": "^0.27.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:mobile": "VITE_HTTPS=true VITE_HOST=true vite",
    "dev:all": "node scripts/dev-harness.js",
    "build": "vite build",
    "build:all": "npm run build:tui && vite build",
    "build:tui": "scripts/build-tui.sh",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "node scripts/test-report.cjs",
    "test:report:quick": "node scripts/test-report.cjs --quick",
    "test:report:history": "node scripts/test-report.cjs --history",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run electron:compile && electron .\"",
    "electron:compile": "tsc -p electron/tsconfig.json && cp electron/package.json electron/dist/",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "electron:build:mac": "npm run build && npm run electron:compile && electron-builder --mac",
    "electron:build:win": "npm run build && npm run electron:compile && electron-builder --win",
    "electron:build:linux": "npm run build && npm run electron:compile && electron-builder --linux"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electron/notarize": "^3.0.0",
    "@playwright/test": "^1.57.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tiptap/core": "^3.17.1",
    "@tiptap/extension-code-block-lowlight": "^3.17.1",
    "@tiptap/extension-image": "^3.17.1",
    "@tiptap/extension-link": "^3.17.1",
    "@tiptap/extension-placeholder": "^3.17.1",
    "@tiptap/extension-table": "^3.17.1",
    "@tiptap/extension-table-cell": "^3.17.1",
    "@tiptap/extension-table-header": "^3.17.1",
    "@tiptap/extension-table-row": "^3.17.1",
    "@tiptap/extension-task-item": "^3.17.1",
    "@tiptap/extension-task-list": "^3.17.1",
    "@tiptap/extension-typography": "^3.17.1",
    "@tiptap/pm": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@uiw/codemirror-theme-github": "^4.25.4",
    "@vitejs/plugin-basic-ssl": "^2.1.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.16",
    "asciichart": "^1.5.25",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "codemirror": "^6.0.1",
    "concurrently": "^9.0.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "fake-indexeddb": "^6.2.5",
    "flexsearch": "^0.7.43",
    "happy-dom": "^20.0.11",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.1",
    "jose": "^6.1.3",
    "lowlight": "^3.3.0",
    "lucide-svelte": "^0.469.0",
    "marked": "^17.0.1",
    "mathjs": "^15.1.0",
    "msw": "^2.12.7",
    "pdfjs-dist": "^5.4.530",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.5",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^3.4.16",
    "tslib": "^2.8.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.2",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.16",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "pako": "^2.1.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
